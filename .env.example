# Copiez ce fichier en .env sur le serveur (dossier deploy/), puis remplissez les valeurs.
# Ne versionnez jamais le fichier .env.

# Domaine public du site, sans https://
# Production : www.digital-solutions.ma. Préproduction : par exemple preprod.digital-solutions.ma.
SITE_DOMAIN=www.digital-solutions.ma
# Domaines redirigés vers SITE_DOMAIN, séparés par des espaces. Laissez vide en préproduction.
DOMAINES_REDIRIGES=digital-solutions.ma
# Adresse e-mail pour Let's Encrypt (alertes d'expiration des certificats)
ACME_EMAIL=
# « noindex » en préproduction, « all » en production
ROBOTS_TAG=all

# Image Docker et version déployée (la CI fournit IMAGE_TAG)
IMAGE=ghcr.io/hrsasn26/asn
IMAGE_TAG=latest

# Envoi des formulaires par e-mail (API transactionnelle de Brevo)
MAIL_TRANSPORT=brevo
BREVO_API_KEY=
# Expéditeur validé dans Brevo, et destinataire des demandes
MAIL_FROM=
MAIL_TO=

# Demandes autorisées par adresse IP toutes les 10 minutes
FORM_RATE_LIMIT_MAX=5
