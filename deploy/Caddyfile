# Caddy obtient et renouvelle le certificat HTTPS automatiquement.
{
	email {$ACME_EMAIL}
}

# SITE_DOMAIN : domaine du site (ex. : www.digital-solutions.ma).
# DOMAINES_REDIRIGES : domaines redirigés vers SITE_DOMAIN (ex. : digital-solutions.ma).
# Vide en préproduction.
{$SITE_DOMAIN} {$DOMAINES_REDIRIGES} {
	encode zstd gzip

	# La politique de sécurité du contenu (CSP) est produite par Astro, page par page.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# « noindex » en préproduction, « all » en production.
		X-Robots-Tag "{$ROBOTS_TAG}"
		-Server
	}

	@autreDomaine not host {$SITE_DOMAIN}
	redir @autreDomaine https://{$SITE_DOMAIN}{uri} permanent

	# Les fichiers de /_astro/ ont un nom unique à chaque build : cache long.
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy web:4321
}
