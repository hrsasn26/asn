# Caddy obtient et renouvelle le certificat HTTPS automatiquement.
{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# La politique de sécurité du contenu (CSP) est produite par Astro, page par page.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# « noindex » en préproduction, « all » en production.
		X-Robots-Tag "{$ROBOTS_TAG}"
		-Server
	}

	# Les fichiers de /_astro/ ont un nom unique à chaque build : cache long.
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy web:4321
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
