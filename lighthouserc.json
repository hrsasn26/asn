{
  "ci": {
    "collect": {
      "startServerCommand": "node dist/server/entry.mjs",
      "startServerReadyPattern": "Server listening",
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/services",
        "http://localhost:4321/services/sites-web",
        "http://localhost:4321/services/intelligence-artificielle",
        "http://localhost:4321/services/tests-securite",
        "http://localhost:4321/methode",
        "http://localhost:4321/agence",
        "http://localhost:4321/audit-gratuit",
        "http://localhost:4321/contact",
        "http://localhost:4321/services/hebergement-maintenance"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
