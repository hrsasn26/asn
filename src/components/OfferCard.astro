---
interface Props {
  title: string;
  text: string;
  idealPour: string;
  items: string[];
  prix: string;
}

const { title, text, idealPour, items, prix } = Astro.props;
---

<article class="flex flex-col rounded-lg border border-slate-200 bg-white p-6">
  <h3 class="text-xl">{title}</h3>
  <p class="mt-2 text-slate-700">{text}</p>
  <p class="mt-3 text-sm text-slate-700">
    <em>Idéal pour :</em> {idealPour}
  </p>
  <ul class="mt-4 list-disc space-y-1 pl-5 text-slate-700">
    {items.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
  <p class="mt-auto pt-6 font-semibold text-slate-900">{prix}</p>
</article>
