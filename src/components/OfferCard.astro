---
/** Carte d'une offre (page Sites web, « Nos formules ») : texte, public visé et contenu. */
import ListePoints from '~/components/ListePoints.astro';
import Texte from '~/components/Texte.astro';

interface Props {
  title: string;
  text: string;
  idealPour: string;
  items: string[];
}

const { title, text, idealPour, items } = Astro.props;
---

<article class="apparition flex min-w-0 flex-[1_1_15rem] flex-col rounded-3xl px-7 py-8 ring-1 ring-ligne ring-inset">
  <h3 class="text-2xl tracking-[-0.02em]">{title}</h3>
  <p class="mt-3 leading-[1.6] text-doux">{text}</p>
  <p class="mt-5 rounded-xl bg-surface px-4 py-3 text-sm leading-normal">
    <span class="block text-[0.6875rem] font-semibold tracking-[0.18em] text-discret uppercase">
      Idéal pour
    </span>{' '}
    <Texte texte={idealPour} />
  </p>
  <ListePoints items={items} variante="lignes" class="mt-6" />
</article>
