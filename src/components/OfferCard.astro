---
import Check from '@lucide/astro/icons/check';

interface Props {
  title: string;
  text: string;
  idealPour: string;
  items: string[];
}

const { title, text, idealPour, items } = Astro.props;
---

<article class="apparition flex flex-col rounded-lg border border-slate-200 bg-white p-6">
  <h3 class="text-xl">{title}</h3>
  <p class="mt-2 text-slate-700">{text}</p>
  <p class="mt-3 text-sm text-slate-700">
    <em>Idéal pour :</em> {idealPour}
  </p>
  <ul class="mt-4 space-y-1 text-slate-700">
    {items.map((item) => (
      <li class="flex items-start gap-2">
        {/* La coche grandit quand elle entre dans l'écran. */}
        <Check
          size={18}
          aria-hidden="true"
          class="apparition-zoom mt-1 shrink-0 text-emerald-600"
        />
        <span>{item}</span>
      </li>
    ))}
  </ul>
</article>
