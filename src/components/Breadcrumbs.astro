---
import JsonLd from '~/components/JsonLd.astro';
import type { LienNav } from '~/data/navigation';

interface Props {
  items: LienNav[];
}

const items = [{ label: 'Accueil', href: '/' }, ...Astro.props.items];
const jsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    item: new URL(item.href, Astro.site).href,
  })),
};
---

<nav aria-label="Fil d'Ariane" class="conteneur pt-8 text-[0.8125rem] sm:pt-10">
  <ol class="flex flex-wrap gap-x-2.5 gap-y-1 text-discret">
    {items.map((item, index) => (
      <li class="flex gap-2.5">
        {index > 0 && <span aria-hidden="true">/</span>}
        {index === items.length - 1 ? (
          <span aria-current="page" class="text-encre">
            {item.label}
          </span>
        ) : (
          <a href={item.href} class="text-discret no-underline hover:text-encre">
            {item.label}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>
<JsonLd data={jsonLd} />
