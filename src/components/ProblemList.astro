---
/**
 * Section « le problème » des pages de services (maquettes : « Le constat ») :
 * un encadré gris, le titre à gauche, les problèmes dans des cases blanches à droite.
 */
import Encadre from '~/components/Encadre.astro';
import Section from '~/components/Section.astro';
import Texte from '~/components/Texte.astro';

interface Props {
  title: string;
  items: string[];
}

const { title, items } = Astro.props;
---

<Section>
  <Encadre ton="gris" surtitre="Le constat" title={title} disposition="colonnes">
    <ul class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,18.75rem),1fr))] gap-3">
      {items.map((item) => (
        <li class="rounded-2xl bg-white px-5.5 py-5 leading-[1.55]">
          <Texte texte={item} />
        </li>
      ))}
    </ul>
  </Encadre>
</Section>
