---
/**
 * Prix de départ d'un service (brief, section 6.22, proposition à valider).
 * Chaque offre a un seul prix, précédé de « À partir de », et un niveau de complexité (simple,
 * intermédiaire, avancé) pour situer un projet : pas de fourchette ni de calcul d'estimation.
 * Les offres et leurs prix viennent de src/data/prix.json, par la page du service.
 * `facteurs` : ce qui fait monter le prix, sans chiffre. Le slot reçoit une précision propre au
 * service (coûts facturés en plus, audit gratuit).
 */
import ListePoints from '~/components/ListePoints.astro';
import Prix from '~/components/Prix.astro';
import Section from '~/components/Section.astro';
import { NIVEAUX, offresDuService, tauxTva, validitePrix } from '~/lib/prix';

interface Props {
  /** Page du service : « /services/sites-web ». */
  service: string;
  title?: string;
  motCle?: string;
  facteurs: string[];
}

const {
  service,
  title = 'Un prix de départ selon la complexité de votre projet',
  motCle = 'la complexité de votre projet',
  facteurs,
} = Astro.props;

const groupes = [
  { titre: undefined, offres: offresDuService(service, 'projet') },
  { titre: 'Options', offres: offresDuService(service, 'option') },
  { titre: 'Après la mise en ligne', offres: offresDuService(service, 'suivi') },
].filter(({ offres }) => offres.length > 0);

const avecNiveaux = groupes.some(({ offres }) => offres.some(({ niveau }) => niveau !== null));
---

<Section
  id="tarifs"
  surtitre="Tarifs"
  title={title}
  motCle={motCle}
  disposition="colonnes"
  titreCollant
>
  <p class="apparition text-lg leading-[1.7] text-doux">
    {avecNiveaux
      ? 'Chaque offre a un prix de départ et un niveau de complexité : simple, intermédiaire ou avancé. Vous situez votre projet, puis nous fixons son prix exact dans un devis.'
      : 'Chaque offre a un prix de départ. Nous fixons le prix exact de votre projet dans un devis.'}
  </p>

  {groupes.map(({ titre, offres }) => (
    <>
      {titre && <p class="apparition surtitre mt-12 text-discret">{titre}</p>}
      <ul class:list={['border-t border-ligne', titre ? 'mt-4' : 'mt-10']}>
        {offres.map((offre) => (
          <li class="apparition flex flex-wrap items-start justify-between gap-x-10 gap-y-4 border-b border-ligne py-6">
            <div class="min-w-0 flex-[1_1_18rem]">
              {offre.niveau && (
                <p class="mb-2.5 flex items-center gap-2.5 text-xs font-semibold text-fonce">
                  {/* Jauge décorative : un à trois traits bleus, selon le niveau. */}
                  <span aria-hidden="true" class="flex gap-1">
                    {[1, 2, 3].map((rang) => (
                      <span
                        class:list={[
                          'h-1.5 w-4 rounded-full',
                          rang <= NIVEAUX[offre.niveau!].rang ? 'bg-bleu' : 'bg-trait',
                        ]}
                      />
                    ))}
                  </span>
                  <span>
                    <span class="sr-only">Niveau :</span> {NIVEAUX[offre.niveau].label}
                  </span>
                </p>
              )}
              <h3 class="text-lg sm:text-[1.1875rem]">{offre.nom}</h3>
              <p class="mt-1.5 text-[0.9375rem] leading-[1.6] text-doux">{offre.description}</p>
            </div>
            <Prix offre={offre} class="flex-[0_1_12.5rem] sm:text-right" />
          </li>
        ))}
      </ul>
    </>
  ))}

  <h3 class="apparition mt-12 text-lg sm:text-[1.1875rem]">Ce qui fait monter le prix</h3>
  <ListePoints items={facteurs} class="apparition mt-4" />

  <div class="apparition mt-10 space-y-3 text-[0.9375rem] leading-[1.65] text-doux">
    <slot />
    <p>
      {`Prix de départ en dirhams, toutes taxes comprises (TVA de ${tauxTva} %). Le prix de votre projet dépend de son contenu : il figure dans un devis gratuit, à prix fixe.`}
      {validitePrix && ` Prix valables jusqu'au ${validitePrix}.`}
    </p>
  </div>
</Section>
