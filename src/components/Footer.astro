---
import IconeWhatsApp from '~/components/IconeWhatsApp.astro';
import Logo from '~/components/Logo.astro';
import { liensLegaux, services } from '~/data/navigation';
import { cta, lienTelephone, site } from '~/data/site';
import { lienWhatsApp } from '~/lib/whatsapp';

// Année du build : le site est reconstruit à chaque déploiement.
const annee = new Date().getFullYear();

// py-0.5 : zone cliquable de 24 px de haut au moins (WCAG 2.5.8).
const lien = 'inline-block py-0.5 text-nuit-texte no-underline hover:text-white';
const titreColonne = 'text-[0.6875rem] font-semibold tracking-[0.2em] text-nuit-pied uppercase';

// Coordonnées : mêmes valeurs et même texte du lien WhatsApp que la page Contact (section 6.11
// du brief). La ligne WhatsApp reste cachée tant que le numéro est un placeholder.
const whatsapp = lienWhatsApp(site.whatsapp, site.messageWhatsApp);
---

{/* --anneau : contour du focus en blanc, visible sur le fond sombre. */}
<footer class="bg-encre text-nuit-texte [--anneau:var(--color-white)]">
  <div class="conteneur flex flex-wrap gap-8 pt-16 pb-8 sm:pt-18">
    <div class="apparition max-w-[23.75rem] min-w-0 flex-[1.6_1_13.75rem]">
      <p>
        <Logo version="blanc" />
      </p>
      <p class="mt-4 text-sm leading-[1.7]">
        Des sites et des applications fiables, testés, sécurisés et suivis dans la durée.
      </p>
    </div>
    {/* Les dix liens des services forment deux colonnes de cinq sur les écrans moyens et grands. */}
    <nav aria-label="Services" class="apparition min-w-0 flex-[2_1_17.5rem] md:[--decalage:1.5rem]">
      <p class={titreColonne}>Services</p>
      <ul class="mt-4 grid gap-x-8 gap-y-1.5 text-sm sm:grid-flow-col sm:grid-rows-5">
        {services.map(({ label, href }) => (
          <li>
            <a href={href} class={lien}>
              {label}
            </a>
          </li>
        ))}
        <li>
          <a href={cta.secondaire.href} class={lien}>
            Audit gratuit
          </a>
        </li>
      </ul>
    </nav>
    <nav
      aria-label="Informations légales"
      class="apparition min-w-0 flex-[1_1_8.75rem] md:[--decalage:3rem]"
    >
      <p class={titreColonne}>Informations</p>
      <ul class="mt-4 grid gap-y-1.5 text-sm">
        <li>
          <a href="/contact" class={lien}>
            Contact
          </a>
        </li>
        {liensLegaux.map(({ label, href }) => (
          <li>
            <a href={href} class={lien}>
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="apparition min-w-0 flex-[1_1_13.75rem] md:[--decalage:4.5rem]">
      <p class={titreColonne}>Contact</p>
      <address class="mt-4 grid gap-y-1.5 text-sm not-italic">
        <p>
          <a href={`mailto:${site.email}`} class={lien}>
            {site.email}
          </a>
        </p>
        <p>
          <a href={lienTelephone} class:list={[lien, 'whitespace-nowrap']}>
            {site.telephone}
          </a>
        </p>
        {whatsapp && (
          <p>
            <a
              href={whatsapp}
              class="inline-flex items-center gap-2 py-0.5 text-nuit-texte no-underline hover:text-white"
            >
              <IconeWhatsApp class="size-4" />
              Nous écrire sur WhatsApp
            </a>
          </p>
        )}
      </address>
    </div>
  </div>
  <div class="conteneur border-t border-nuit-ligne pt-6 pb-10 text-[0.8125rem] text-nuit-pied">
    <p>{`© ${annee} ${site.nom}. Tous droits réservés.`}</p>
  </div>
</footer>
