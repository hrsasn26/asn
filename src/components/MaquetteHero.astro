---
/**
 * Maquette d'écrans (ordinateur, téléphone, cartes) pour un client fictif : visuel de l'en-tête
 * des pages, vignette des cartes de services, encadré de l'audit gratuit.
 *
 * Les images sont déjà aux bonnes tailles (`pnpm image:heros`) : Astro les copie telles quelles.
 * Avec le composant Picture d'Astro, une page rendue par le serveur (Audit gratuit) convertirait
 * l'image à chaque visite.
 */
import type { ImageMetadata } from 'astro';
import {
  HAUTEUR_MAQUETTE,
  LARGEUR_MAQUETTE,
  LARGEURS_AVIF,
  legendeMaquette,
  maquettes,
  type NomMaquette,
} from '~/data/maquettes';

interface Props {
  nom: NomMaquette;
  /** Largeur affichée selon l'écran (attribut sizes) : voir TAILLES_MAQUETTE dans src/data/maquettes.ts. */
  sizes: string;
  /** Haut de la page : l'image est chargée en priorité (souvent le plus grand élément affiché). */
  prioritaire?: boolean;
  /** Le texte voisin dit déjà ce que montre l'image (vignette, encadré) : texte alternatif vide. */
  decoratif?: boolean;
  /** Légende « Exemple fictif » sous l'image. */
  legende?: boolean;
  /** Légende sur fond sombre. */
  sombre?: boolean;
  class?: string;
}

const {
  nom,
  sizes,
  prioritaire = false,
  decoratif = false,
  legende = true,
  sombre = false,
  class: classe,
} = Astro.props;

const images = import.meta.glob<ImageMetadata>('/src/assets/heros/*.{avif,webp}', {
  eager: true,
  import: 'default',
});

function image(fichier: string) {
  const trouvee = images[`/src/assets/heros/${fichier}`];
  if (!trouvee) {
    throw new Error(
      `Image absente : src/assets/heros/${fichier}. Lancez « pnpm image:heros ${nom} ».`,
    );
  }
  return trouvee;
}

const avif = LARGEURS_AVIF.map((largeur) => `${image(`${nom}-${largeur}.avif`).src} ${largeur}w`);
const webp = image(`${nom}.webp`);
const Conteneur = legende ? 'figure' : 'div';
---

<Conteneur class={classe}>
  <picture>
    <source type="image/avif" srcset={avif.join(', ')} sizes={sizes} />
    <img
      src={webp.src}
      alt={decoratif ? '' : maquettes[nom]}
      width={LARGEUR_MAQUETTE}
      height={HAUTEUR_MAQUETTE}
      loading={prioritaire ? 'eager' : 'lazy'}
      fetchpriority={prioritaire ? 'high' : undefined}
      decoding={prioritaire ? undefined : 'async'}
      class="h-auto w-full"
    />
  </picture>
  {legende && (
    <figcaption
      class:list={['mt-2 text-center text-xs', sombre ? 'text-nuit-discret' : 'text-discret']}
    >
      {legendeMaquette}
    </figcaption>
  )}
</Conteneur>
