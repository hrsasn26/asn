---
/**
 * Visuel de l'en-tête : maquette d'écrans (ordinateur, téléphone, cartes) pour un client fictif.
 *
 * Les images sont déjà aux bonnes tailles (`pnpm image:heros`) : Astro les copie telles quelles.
 * Avec le composant Picture d'Astro, une page rendue par le serveur (Audit gratuit) convertirait
 * l'image à chaque visite.
 *
 * L'image est chargée en priorité : c'est souvent le plus grand élément du haut de la page.
 * Sur grand écran, elle déborde un peu dans la marge de droite (xl:-mr-16). Les tailles de
 * `sizes` suivent la grille du composant Hero.
 */
import type { ImageMetadata } from 'astro';
import {
  HAUTEUR_MAQUETTE,
  LARGEUR_MAQUETTE,
  LARGEURS_AVIF,
  legendeMaquette,
  maquettes,
  type NomMaquette,
} from '~/data/maquettes';

interface Props {
  nom: NomMaquette;
}

const { nom } = Astro.props;

const images = import.meta.glob<ImageMetadata>('/src/assets/heros/*.{avif,webp}', {
  eager: true,
  import: 'default',
});

function image(fichier: string) {
  const trouvee = images[`/src/assets/heros/${fichier}`];
  if (!trouvee) {
    throw new Error(
      `Image absente : src/assets/heros/${fichier}. Lancez « pnpm image:heros ${nom} ».`,
    );
  }
  return trouvee;
}

const avif = LARGEURS_AVIF.map((largeur) => `${image(`${nom}-${largeur}.avif`).src} ${largeur}w`);
const webp = image(`${nom}.webp`);
const sizes =
  '(min-width: 1280px) 596px, (min-width: 1152px) 532px, (min-width: 768px) calc(50vw - 44px), (min-width: 640px) calc(100vw - 48px), calc(100vw - 32px)';
---

<figure class="anim-montee delai-300 xl:-mr-16">
  <picture>
    <source type="image/avif" srcset={avif.join(', ')} sizes={sizes} />
    <img
      src={webp.src}
      alt={maquettes[nom]}
      width={LARGEUR_MAQUETTE}
      height={HAUTEUR_MAQUETTE}
      loading="eager"
      fetchpriority="high"
      class="h-auto w-full"
    />
  </picture>
  <figcaption class="mt-2 text-center text-xs text-slate-600">{legendeMaquette}</figcaption>
</figure>
