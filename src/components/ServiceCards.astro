---
// Cartes des neuf pôles (docs/brief-agence.md, section 6.1).
import AppWindow from '@lucide/astro/icons/app-window';
import ChartColumn from '@lucide/astro/icons/chart-column';
import Cloud from '@lucide/astro/icons/cloud';
import Globe from '@lucide/astro/icons/globe';
import ServerCog from '@lucide/astro/icons/server-cog';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Smartphone from '@lucide/astro/icons/smartphone';
import Sparkles from '@lucide/astro/icons/sparkles';
import Workflow from '@lucide/astro/icons/workflow';
import ServiceCard from '~/components/ServiceCard.astro';
---

<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
  <ServiceCard
    title="Sites web"
    icone={Globe}
    text="Un site vitrine ou une boutique en ligne rapide, bien référencé et facile à mettre à jour."
    items={[
      'Site vitrine',
      'Boutique en ligne',
      'Refonte de site existant',
      'Sites en français, arabe et anglais',
    ]}
    link={{ label: "Découvrir l'offre Sites web", href: '/services/sites-web' }}
  />
  <ServiceCard
    title="Applications sur mesure"
    icone={AppWindow}
    text="Un outil conçu pour votre façon de travailler : réservation, devis, planning ou espace client."
    items={[
      'Outils métier',
      'Espaces clients et portails',
      "Première version de votre projet d'application",
    ]}
    link={{ label: "Découvrir l'offre Applications", href: '/services/applications-sur-mesure' }}
  />
  <ServiceCard
    title="Applications mobiles"
    icone={Smartphone}
    text="Une application iPhone et Android pour vos clients ou pour vos équipes, publiée et suivie par nos soins."
    items={[
      'Applications pour vos clients',
      'Applications pour vos équipes',
      "Publication sur l'App Store et Google Play",
    ]}
    link={{
      label: "Découvrir l'offre Applications mobiles",
      href: '/services/applications-mobiles',
    }}
  />
  <ServiceCard
    title="Logiciels SaaS"
    icone={Cloud}
    text="Votre logiciel en ligne, vendu par abonnement et construit pour accueillir de plus en plus de clients."
    items={[
      'Comptes clients et abonnements',
      'Paiement en ligne',
      'Première version, puis évolutions',
    ]}
    link={{ label: "Découvrir l'offre Logiciels SaaS", href: '/services/logiciels-saas' }}
  />
  <ServiceCard
    title="Intelligence artificielle"
    icone={Sparkles}
    text="L'IA là où elle vous fait vraiment gagner du temps, avec des résultats vérifiés."
    items={[
      'Assistants pour vos clients et vos équipes',
      'Traitement de documents',
      'Formation de vos équipes',
    ]}
    link={{
      label: "Découvrir l'offre Intelligence artificielle",
      href: '/services/intelligence-artificielle',
    }}
  />
  <ServiceCard
    title="Automatisation et intégrations"
    icone={Workflow}
    text="Vos logiciels connectés entre eux, et les tâches répétitives faites automatiquement."
    items={[
      'Connexion de vos outils',
      'Automatisation des tâches',
      'WhatsApp connecté à vos outils',
    ]}
    link={{
      label: "Découvrir l'offre Automatisation",
      href: '/services/automatisation-integrations',
    }}
  />
  <ServiceCard
    title="Données et tableaux de bord"
    icone={ChartColumn}
    text="Vos chiffres clés réunis sur un seul écran, fiables et mis à jour automatiquement."
    items={[
      "Mesure d'audience de votre site",
      'Tableaux de bord de votre activité',
      'Rapports automatiques',
    ]}
    link={{ label: "Découvrir l'offre Données", href: '/services/donnees-tableaux-de-bord' }}
  />
  <ServiceCard
    title="Tests et sécurité"
    icone={ShieldCheck}
    text="Vos sites et vos applications vérifiés par des spécialistes des tests, même si nous ne les avons pas développés."
    items={[
      'Audit de sécurité',
      'Tests avant une mise en ligne',
      'Tests automatiques et tests de charge',
    ]}
    link={{ label: "Découvrir l'offre Tests et sécurité", href: '/services/tests-securite' }}
  />
  <ServiceCard
    title="Hébergement et maintenance"
    icone={ServerCog}
    text="Votre site en ligne, sauvegardé et à jour. Vous n'avez plus à y penser."
    items={['Hébergement sécurisé', 'Sauvegardes et mises à jour', 'Reprise de site existant']}
    link={{ label: 'Découvrir nos forfaits', href: '/services/hebergement-maintenance' }}
  />
</div>
