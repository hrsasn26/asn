---
import ButtonLink from '~/components/ButtonLink.astro';
import Logo from '~/components/Logo.astro';
import { navigationPrincipale } from '~/data/navigation';
import { cta } from '~/data/site';
import { cheminPublic } from '~/lib/url';

const path = cheminPublic(Astro.url.pathname);
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);

// Menu mobile : chaque lien arrive un peu après le précédent (classes écrites en entier pour Tailwind).
const delaisGlisse = [
  '[--delai-glisse:0ms]',
  '[--delai-glisse:50ms]',
  '[--delai-glisse:100ms]',
  '[--delai-glisse:150ms]',
  '[--delai-glisse:200ms]',
  '[--delai-glisse:250ms]',
];
---

{/* L'en-tête reste en haut de l'écran pendant le défilement, sur un fond blanc translucide. */}
<header class="sticky top-0 z-30 border-b border-ligne bg-white/90 backdrop-blur-md [view-transition-name:entete]">
  <div class="conteneur flex h-[4.75rem] items-center justify-between gap-6">
    <a href="/" class="no-underline">
      <Logo />
    </a>

    <nav aria-label="Navigation principale" class="hidden lg:block">
      <ul class="flex items-center gap-9 text-[0.9375rem] font-medium">
        {navigationPrincipale.map((lien) => (
          <li>
            {/* Page courante : texte bleu nuit et trait dessous. Au survol, le trait se dessine. */}
            <a
              href={lien.href}
              aria-current={isCurrent(lien.href) ? 'page' : undefined}
              class="relative block py-1.5 text-texte no-underline after:absolute after:inset-x-0 after:bottom-0 after:h-[1.5px] after:origin-left after:scale-x-0 after:bg-current hover:text-encre hover:after:scale-x-100 aria-[current=page]:text-encre aria-[current=page]:after:scale-x-100 motion-safe:after:transition-transform"
            >
              {lien.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden lg:block">
      <ButtonLink href={cta.principal.href} variant="contour" taille="petit">
        {cta.principal.label}
      </ButtonLink>
    </div>

    <details class="group relative lg:hidden">
      <summary class="flex cursor-pointer list-none items-center gap-2 rounded-full px-4 py-2.5 text-sm font-semibold text-encre ring-1 ring-contour transition-colors ring-inset hover:ring-encre [&::-webkit-details-marker]:hidden">
        {/* Trois traits qui se changent en croix quand le menu est ouvert. */}
        <svg
          aria-hidden="true"
          focusable="false"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          class="size-5"
        >
          <path
            d="M4 7h16"
            class="origin-center [transform-box:fill-box] group-open:translate-y-[5px] group-open:rotate-45 motion-safe:transition-transform"
          ></path>
          <path d="M4 12h16" class="group-open:opacity-0 motion-safe:transition-opacity"></path>
          <path
            d="M4 17h16"
            class="origin-center [transform-box:fill-box] group-open:-translate-y-[5px] group-open:-rotate-45 motion-safe:transition-transform"
          ></path>
        </svg>
        Menu
      </summary>
      <nav
        aria-label="Navigation principale (mobile)"
        class="absolute right-0 z-40 mt-3 w-72 rounded-2xl bg-white p-5 shadow-[0_24px_48px_-28px_rgb(11_27_51/0.45)] ring-1 ring-ligne motion-safe:group-open:animate-deroule"
      >
        <ul class="flex flex-col gap-1">
          {navigationPrincipale.map((lien, index) => (
            <li class:list={['motion-safe:group-open:animate-glisse', delaisGlisse[index]]}>
              <a
                href={lien.href}
                aria-current={isCurrent(lien.href) ? 'page' : undefined}
                class="block py-2 text-base font-medium text-texte no-underline hover:text-encre aria-[current=page]:font-semibold aria-[current=page]:text-encre"
              >
                {lien.label}
              </a>
            </li>
          ))}
        </ul>
        <div
          class:list={[
            'mt-4 motion-safe:group-open:animate-glisse',
            delaisGlisse[navigationPrincipale.length],
          ]}
        >
          <ButtonLink href={cta.principal.href} class="w-full">
            {cta.principal.label}
          </ButtonLink>
        </div>
      </nav>
    </details>
  </div>
</header>
