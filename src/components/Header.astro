---
import ButtonLink from '~/components/ButtonLink.astro';
import { navigationPrincipale } from '~/data/navigation';
import { cta, site } from '~/data/site';
import { cheminPublic } from '~/lib/url';

const path = cheminPublic(Astro.url.pathname);
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);

// Menu mobile : chaque lien arrive un peu après le précédent (classes écrites en entier pour Tailwind).
const delaisGlisse = [
  '[--delai-glisse:0ms]',
  '[--delai-glisse:50ms]',
  '[--delai-glisse:100ms]',
  '[--delai-glisse:150ms]',
  '[--delai-glisse:200ms]',
  '[--delai-glisse:250ms]',
];
---

<header class="relative z-30 border-b border-slate-200 bg-white [view-transition-name:entete]">
  {/* Barre aux couleurs des services : elle se remplit à l'ouverture de chaque page. */}
  <div
    aria-hidden="true"
    class="anim-chargement absolute inset-x-0 top-0 h-1 bg-linear-to-r from-blue-700 via-emerald-500 to-violet-600"
  ></div>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
    <a href="/" class="text-lg font-bold text-slate-900 no-underline hover:text-brand-700">
      {site.nom}
    </a>

    <nav aria-label="Navigation principale" class="hidden lg:block">
      <ul class="flex items-center gap-6">
        {navigationPrincipale.map((lien) => (
          <li>
            <a
              href={lien.href}
              aria-current={isCurrent(lien.href) ? 'page' : undefined}
              class="relative text-slate-700 no-underline after:absolute after:inset-x-0 after:-bottom-1 after:h-0.5 after:origin-left after:scale-x-0 after:bg-current hover:text-brand-700 hover:after:scale-x-100 aria-[current=page]:font-semibold aria-[current=page]:text-brand-800 aria-[current=page]:after:scale-x-100 motion-safe:after:transition-transform"
            >
              {lien.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden lg:block">
      <ButtonLink href={cta.principal.href}>{cta.principal.label}</ButtonLink>
    </div>

    <details class="group relative lg:hidden">
      <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md border border-slate-300 px-3 py-2 font-medium text-slate-800 transition-colors hover:border-slate-400 hover:bg-slate-50 [&::-webkit-details-marker]:hidden">
        {/* Trois traits qui se changent en croix quand le menu est ouvert. */}
        <svg
          aria-hidden="true"
          focusable="false"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          class="size-5"
        >
          <path
            d="M4 7h16"
            class="origin-center [transform-box:fill-box] group-open:translate-y-[5px] group-open:rotate-45 motion-safe:transition-transform"
          ></path>
          <path d="M4 12h16" class="group-open:opacity-0 motion-safe:transition-opacity"></path>
          <path
            d="M4 17h16"
            class="origin-center [transform-box:fill-box] group-open:-translate-y-[5px] group-open:-rotate-45 motion-safe:transition-transform"
          ></path>
        </svg>
        Menu
      </summary>
      <nav
        aria-label="Navigation principale (mobile)"
        class="absolute right-0 z-40 mt-2 w-64 rounded-md border border-slate-200 bg-white p-4 shadow-lg motion-safe:group-open:animate-deroule"
      >
        <ul class="flex flex-col gap-3">
          {navigationPrincipale.map((lien, index) => (
            <li class:list={['motion-safe:group-open:animate-glisse', delaisGlisse[index]]}>
              <a
                href={lien.href}
                aria-current={isCurrent(lien.href) ? 'page' : undefined}
                class="block text-slate-800 no-underline hover:text-brand-700 aria-[current=page]:font-semibold aria-[current=page]:text-brand-800"
              >
                {lien.label}
              </a>
            </li>
          ))}
        </ul>
        <div
          class:list={[
            'mt-4 motion-safe:group-open:animate-glisse',
            delaisGlisse[navigationPrincipale.length],
          ]}
        >
          <ButtonLink href={cta.principal.href}>{cta.principal.label}</ButtonLink>
        </div>
      </nav>
    </details>
  </div>
</header>
