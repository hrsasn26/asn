---
/**
 * Étapes d'un projet, côte à côte (maquettes) : un numéro dans un cercle, un trait jusqu'à
 * l'étape suivante, puis le titre et le texte. La dernière étape a un cercle plein.
 * Sur téléphone, les étapes passent à la ligne.
 */
import Texte from '~/components/Texte.astro';

export interface Step {
  title: string;
  text: string;
}

interface Props {
  items: Step[];
}

const { items } = Astro.props;
---

<ol class="flex flex-wrap gap-x-6 gap-y-8">
  {items.map((item, index) => {
    const derniere = index === items.length - 1;
    return (
      <li class="apparition min-w-0 flex-[1_1_9.375rem]">
        <div aria-hidden="true" class="flex items-center gap-3.5">
          <span
            class:list={[
              'apparition-zoom grid size-11 shrink-0 place-items-center rounded-full text-[0.9375rem] font-semibold',
              derniere ? 'bg-encre text-white' : 'ring-1 ring-encre ring-inset',
            ]}
          >
            {index + 1}
          </span>
          {!derniere && <span class="h-px flex-1 bg-trait" />}
        </div>
        <p class="mt-5.5">
          <strong class="block text-[1.0625rem] font-semibold">{item.title}</strong>{' '}
          <span class="mt-2 block text-[0.9375rem] leading-[1.6] text-doux">
            <Texte texte={item.text} />
          </span>
        </p>
      </li>
    );
  })}
</ol>
