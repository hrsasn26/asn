---
/**
 * Mise en forme des contenus longs (pages légales).
 * Les intertitres, les paragraphes et les listes montent en place quand ils entrent dans l'écran.
 * Les liens du texte sont soulignés : la couleur seule ne suffit pas à les repérer (WCAG 1.4.1).
 * Les placeholders entre crochets sont surlignés, comme ailleurs sur le site (composant Texte) :
 * le remplacement ne touche que le texte, jamais l'intérieur des balises.
 */
const html = await Astro.slots.render('default');
const avecPlaceholders = html
  .split(/(<[^>]+>)/)
  .map((morceau) =>
    morceau.startsWith('<')
      ? morceau
      : morceau.replace(
          /\[[^\]<>]+\]/g,
          (placeholder) => `<span class="a-completer">${placeholder}</span>`,
        ),
  )
  .join('');
---

<div
  class="max-w-3xl space-y-4 leading-[1.75] text-doux [&_a]:text-bleu [&_a]:underline [&_a]:underline-offset-2 [&_a:hover]:text-encre [&_a:hover]:underline-offset-4 [&_h2]:mt-14 [&_h2]:text-[1.75rem] [&_h2]:leading-tight [&_h2]:tracking-[-0.02em] [&_h2]:text-encre [&_h2]:apparition [&_h3]:mt-8 [&_h3]:text-xl [&_h3]:text-encre [&_li]:ml-5 [&_ol]:list-decimal [&_ol]:apparition [&_p]:apparition [&_strong]:font-semibold [&_strong]:text-encre [&_ul]:list-disc [&_ul]:apparition"
  set:html={avecPlaceholders}
/>
