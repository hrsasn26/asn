---
/**
 * Bandeau des cookies (textes : section 6.21 du brief, à valider).
 *
 * Caché sans JavaScript : sans JavaScript, Google Tag Manager ne se charge pas non plus.
 * Le script l'affiche tant que le visiteur n'a pas choisi, et charge Tag Manager après
 * « Accepter » (src/lib/consentement.ts). Le lien « Gérer les cookies » du pied de page
 * l'affiche de nouveau.
 *
 * Les deux boutons ont le même style : refuser est aussi simple qu'accepter.
 */
const bouton =
  'cursor-pointer rounded-full bg-bleu px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-encre';
---

<section
  data-bandeau-cookies
  hidden
  aria-labelledby="bandeau-cookies-titre"
  class="fixed inset-x-0 bottom-0 z-40 px-4 pb-4 sm:px-6 sm:pb-6"
>
  <div class="mx-auto max-w-3xl rounded-2xl bg-white p-6 shadow-xl shadow-encre/15 ring-1 ring-trait">
    <p id="bandeau-cookies-titre" class="font-semibold text-encre">
      Cookies
    </p>
    <p class="mt-2 text-sm leading-[1.65] text-doux">
      Avec votre accord, nous utilisons des cookies de Google pour mesurer l'efficacité de nos
      annonces. Vous pouvez changer d'avis à tout moment avec le lien « Gérer les cookies », en bas
      de chaque page. Détails dans notre{' '}
      <a
        href="/confidentialite"
        class="text-bleu underline underline-offset-2 hover:text-encre hover:underline-offset-4"
      >
        politique de confidentialité
      </a>
      .
    </p>
    <div class="mt-4 flex flex-wrap gap-3">
      <button type="button" data-choix-cookies="refuse" class={bouton}>
        Refuser
      </button>
      <button type="button" data-choix-cookies="accepte" class={bouton}>
        Accepter
      </button>
    </div>
  </div>
</section>

<script>
  import { site } from '~/data/site';
  import {
    CLE_CONSENTEMENT,
    type ChoixCookies,
    cookiesGoogle,
    lireChoix,
    tagManagerAutorise,
    urlTagManager,
  } from '~/lib/consentement';

  const bandeau = document.querySelector<HTMLElement>('[data-bandeau-cookies]');
  const fenetre = window as typeof window & { dataLayer?: Record<string, unknown>[] };
  let tagManagerCharge = false;

  // Le stockage local peut être bloqué (navigation privée, réglages du navigateur) :
  // le bandeau s'affiche alors à chaque page, et Tag Manager ne se charge qu'après un clic.
  function choixEnregistre(): ChoixCookies | undefined {
    try {
      return lireChoix(localStorage.getItem(CLE_CONSENTEMENT));
    } catch {
      return undefined;
    }
  }

  function enregistrer(choix: ChoixCookies) {
    try {
      localStorage.setItem(CLE_CONSENTEMENT, choix);
    } catch {
      // Choix valable pour cette page seulement.
    }
  }

  function chargerTagManager() {
    if (tagManagerCharge || !tagManagerAutorise(location.hostname, site.domaine)) return;
    tagManagerCharge = true;
    const dataLayer = (fenetre.dataLayer ??= []);
    dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
    // Formulaire envoyé (Contact, Audit gratuit) : événement pour les conversions Google Ads.
    const envoi = document.querySelector<HTMLElement>('[data-formulaire-envoye]');
    if (envoi) {
      dataLayer.push({ event: 'formulaire_envoye', formulaire: envoi.dataset.formulaireEnvoye });
    }
    const script = document.createElement('script');
    script.async = true;
    script.src = urlTagManager(site.tagManager);
    document.head.append(script);
  }

  // Retrait de l'accord : les cookies de Google sont effacés (sur le domaine et sur ses
  // sous-domaines), puis la page est rechargée pour arrêter Tag Manager.
  function effacerCookiesGoogle() {
    const domaine = location.hostname.replace(/^www\./, '');
    for (const nom of cookiesGoogle(document.cookie)) {
      for (const cible of ['', `; domain=${location.hostname}`, `; domain=.${domaine}`]) {
        document.cookie = `${nom}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/${cible}`;
      }
    }
  }

  function choisir(choix: ChoixCookies) {
    enregistrer(choix);
    if (bandeau) bandeau.hidden = true;
    if (choix === 'accepte') {
      chargerTagManager();
    } else if (tagManagerCharge) {
      effacerCookiesGoogle();
      location.reload();
    }
  }

  for (const bouton of document.querySelectorAll<HTMLButtonElement>('[data-choix-cookies]')) {
    bouton.addEventListener('click', () => {
      const choix = lireChoix(bouton.dataset.choixCookies ?? null);
      if (choix) choisir(choix);
    });
  }

  // Lien « Gérer les cookies » (pied de page) : caché sans JavaScript, comme le bandeau.
  for (const lien of document.querySelectorAll<HTMLButtonElement>('[data-gerer-cookies]')) {
    lien.hidden = false;
    lien.addEventListener('click', () => {
      if (!bandeau) return;
      bandeau.hidden = false;
      bandeau.querySelector<HTMLButtonElement>('[data-choix-cookies]')?.focus();
    });
  }

  const choix = choixEnregistre();
  if (choix === 'accepte') chargerTagManager();
  else if (!choix && bandeau) bandeau.hidden = false;
</script>
