---
/**
 * Lien vers une autre page (« Voir l'offre … → ») : la flèche avance au survol.
 * Le dernier mot et la flèche restent sur la même ligne.
 */
interface Props {
  href: string;
  label: string;
  /** Sur fond sombre : lien blanc. */
  sombre?: boolean;
}

const { href, label, sombre = false } = Astro.props;
const mots = label.split(' ');
const fin = mots.pop();
const debut = mots.join(' ');
---

<a
  href={href}
  class:list={[
    'group text-[0.9375rem] font-semibold no-underline',
    sombre ? 'text-white hover:text-nuit-survol' : 'text-bleu hover:text-encre',
  ]}
>
  {debut}{' '}
  <span class="whitespace-nowrap">
    {fin}
    <span
      aria-hidden="true"
      class="ml-1 inline-block transition-transform motion-safe:group-hover:translate-x-1"
    >
      →
    </span>
  </span>
</a>
