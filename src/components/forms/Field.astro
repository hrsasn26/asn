---
import CircleAlert from '@lucide/astro/icons/circle-alert';

interface Props {
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'textarea';
  required?: boolean;
  autocomplete?: string;
  value?: string | undefined;
  errors?: string[] | undefined;
  hint?: string;
  inputmode?: 'url' | 'text' | 'email' | 'tel';
  class?: string;
}

const {
  name,
  label,
  type = 'text',
  required = false,
  autocomplete,
  value,
  errors,
  hint,
  inputmode,
  class: classe,
} = Astro.props;

const id = `champ-${name}`;
const erreur = errors?.[0];
const describedBy =
  [hint && `${id}-aide`, erreur && `${id}-erreur`].filter(Boolean).join(' ') || undefined;
// Bordure des champs : contraste de 3:1 au moins avec le fond (WCAG 1.4.11).
const classes = [
  'block w-full rounded-xl border bg-white px-4 py-3.5 text-[0.9375rem] text-encre transition-colors focus:border-bleu',
  erreur ? 'border-red-700' : 'border-champ',
];
---

{/* Seuls les champs facultatifs sont signalés : les autres sont obligatoires (attribut required). */}
<div class:list={['group flex flex-col gap-2', classe]}>
  <label for={id} class="text-sm font-semibold transition-colors group-focus-within:text-bleu">
    {required ? (
      label
    ) : (
      <>
        {label} <span class="font-normal text-discret">(facultatif)</span>
      </>
    )}
  </label>
  {hint && (
    <p id={`${id}-aide`} class="-mt-1 text-sm text-discret">
      {hint}
    </p>
  )}
  {type === 'textarea' ? (
    <textarea
      id={id}
      name={name}
      rows="5"
      required={required}
      aria-invalid={erreur ? 'true' : undefined}
      aria-describedby={describedBy}
      class:list={[classes, 'resize-y']}
    >{value}</textarea>
  ) : (
    <input
      id={id}
      name={name}
      type={type}
      value={value}
      required={required}
      autocomplete={autocomplete}
      inputmode={inputmode}
      aria-invalid={erreur ? 'true' : undefined}
      aria-describedby={describedBy}
      class:list={classes}
    />
  )}
  {erreur && (
    <p id={`${id}-erreur`} class="flex items-center gap-1.5 text-sm font-medium text-red-700">
      <CircleAlert size={16} aria-hidden="true" class="anim-zoom shrink-0 delai-300" />
      {erreur}
    </p>
  )}
</div>
