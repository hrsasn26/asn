---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div
  role="status"
  class="flex items-start gap-4 rounded-md border-2 border-green-700 bg-green-50 p-6 text-green-900"
>
  <svg aria-hidden="true" focusable="false" viewBox="0 0 48 48" class="size-10 shrink-0">
    <circle cx="24" cy="24" r="22" class="anim-zoom fill-green-700"></circle>
    <path
      d="M14 25l7 7 13-15"
      pathLength="1"
      fill="none"
      class="anim-trace stroke-white delai-350"
      stroke-width="5"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
  </svg>
  <div>
    <h2 class="text-xl text-green-900">{title}</h2>
    <div class="mt-2">
      <slot />
    </div>
  </div>
</div>
