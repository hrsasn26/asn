---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div role="status" class="flex items-start gap-4">
  {/* Coche verte : le cercle apparaît, puis la coche se dessine. */}
  <svg aria-hidden="true" focusable="false" viewBox="0 0 48 48" class="size-11 shrink-0">
    <circle cx="24" cy="24" r="22" class="anim-zoom fill-green-700"></circle>
    <path
      d="M14 25l7 7 13-15"
      pathLength="1"
      fill="none"
      class="anim-trace stroke-white delai-350"
      stroke-width="5"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
  </svg>
  <div>
    <h2 class="text-2xl font-semibold tracking-[-0.02em]">{title}</h2>
    <div class="mt-2 leading-[1.65] text-doux">
      <slot />
    </div>
  </div>
</div>
