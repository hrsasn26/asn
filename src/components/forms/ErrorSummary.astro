---
interface Props {
  /** Erreurs par champ, dans l'ordre du formulaire. */
  errors: { name: string; message: string }[];
  /** Erreur générale (envoi impossible, trop de demandes…). */
  message?: string | undefined;
}

const { errors, message } = Astro.props;
---

{(errors.length > 0 || message) && (
  <div
    role="alert"
    id="erreurs-formulaire"
    tabindex="-1"
    class="anim-alerte rounded-2xl border-2 border-red-700 bg-red-50 p-5 text-red-900"
  >
    {errors.length > 0 ? (
      <>
        <h2 class="text-lg font-semibold text-red-900">
          {errors.length === 1
            ? 'Le formulaire contient 1 erreur'
            : `Le formulaire contient ${errors.length} erreurs`}
        </h2>
        <ul class="mt-2 list-disc pl-5">
          {errors.map((erreur) => (
            <li>
              <a
                href={`#champ-${erreur.name}`}
                class="underline underline-offset-2 hover:underline-offset-4"
              >
                {erreur.message}
              </a>
            </li>
          ))}
        </ul>
      </>
    ) : (
      <p>{message}</p>
    )}
  </div>
)}
