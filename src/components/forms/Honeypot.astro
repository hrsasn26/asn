---
/** Champ piège contre le spam. Il est hors écran et ignoré par les technologies d'assistance. */
---

<div aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden">
  <label for="champ-website">Ne remplissez pas ce champ</label>
  <input id="champ-website" name="website" type="text" tabindex="-1" autocomplete="off" />
</div>
