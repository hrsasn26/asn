---
import CircleAlert from '@lucide/astro/icons/circle-alert';

interface Props {
  errors?: string[] | undefined;
  checked?: boolean;
}

const { errors, checked = false } = Astro.props;
const erreur = errors?.[0];
---

<div>
  <div class="flex items-start gap-3">
    <input
      id="champ-consentement"
      name="consentement"
      type="checkbox"
      required
      checked={checked}
      aria-invalid={erreur ? 'true' : undefined}
      aria-describedby={erreur ? 'champ-consentement-erreur' : undefined}
      class="mt-0.5 size-5 shrink-0 accent-encre"
    />
    <label for="champ-consentement" class="text-sm leading-[1.55] text-texte">
      J'accepte que mes données soient utilisées pour répondre à ma demande, selon la{' '}
      <a
        href="/confidentialite"
        class="text-bleu underline underline-offset-2 hover:text-encre hover:underline-offset-4"
      >
        politique de confidentialité
      </a>
      .
    </label>
  </div>
  {erreur && (
    <p
      id="champ-consentement-erreur"
      class="mt-2 flex items-center gap-1.5 text-sm font-medium text-red-700"
    >
      <CircleAlert size={16} aria-hidden="true" class="anim-zoom shrink-0 delai-300" />
      {erreur}
    </p>
  )}
</div>
