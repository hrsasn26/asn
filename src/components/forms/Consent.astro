---
interface Props {
  errors?: string[] | undefined;
  checked?: boolean;
}

const { errors, checked = false } = Astro.props;
const erreur = errors?.[0];
---

<div>
  <div class="flex items-start gap-3">
    <input
      id="champ-consentement"
      name="consentement"
      type="checkbox"
      required
      checked={checked}
      aria-invalid={erreur ? 'true' : undefined}
      aria-describedby={erreur ? 'champ-consentement-erreur' : undefined}
      class="mt-1 size-5 shrink-0 accent-brand-700"
    />
    <label for="champ-consentement" class="text-slate-800">
      J'accepte que mes données soient utilisées pour répondre à ma demande, selon la{' '}
      <a href="/confidentialite" class="text-brand-700 underline">
        politique de confidentialité
      </a>
      . (obligatoire)
    </label>
  </div>
  {erreur && (
    <p id="champ-consentement-erreur" class="mt-1 text-sm font-medium text-red-700">
      {erreur}
    </p>
  )}
</div>
