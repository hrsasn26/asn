---
interface Props {
  title: string;
  text: string;
  button: { label: string; href: string };
}

const { title, text, button } = Astro.props;
---

<section class="bg-brand-900 text-white">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <h2 class="text-2xl text-white sm:text-3xl">{title}</h2>
    <p class="mt-4 max-w-2xl text-brand-100">{text}</p>
    <div class="mt-8">
      <a
        href={button.href}
        class="inline-block rounded-md bg-white px-5 py-3 font-semibold text-brand-900 no-underline hover:bg-brand-50 transition hover:shadow-md motion-safe:hover:-translate-y-0.5"
      >
        {button.label}
      </a>
    </div>
  </div>
</section>
