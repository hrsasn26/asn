---
/** Appel à l'action en bas de page (maquettes) : grand titre centré, texte et bouton. */
import Accent from '~/components/Accent.astro';
import ButtonLink from '~/components/ButtonLink.astro';
import Texte from '~/components/Texte.astro';

interface Props {
  title: string;
  /** Partie du titre en gras. */
  motCle?: string;
  text: string;
  button: { label: string; href: string };
}

const { title, motCle, text, button } = Astro.props;
---

<section class="conteneur flex flex-col items-center py-24 text-center sm:py-36">
  <h2 class="apparition text-appel">
    <Accent texte={title} motCle={motCle} />
  </h2>
  <p class="apparition mt-6 max-w-[37.5rem] text-lg leading-[1.7] text-texte">
    <Texte texte={text} />
  </p>
  <ButtonLink href={button.href} taille="grand" class="apparition mt-9">
    {button.label}
  </ButtonLink>
</section>
