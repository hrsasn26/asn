---
import AppWindow from '@lucide/astro/icons/app-window';
import ChartColumn from '@lucide/astro/icons/chart-column';
import Cloud from '@lucide/astro/icons/cloud';
import Globe from '@lucide/astro/icons/globe';
import ServerCog from '@lucide/astro/icons/server-cog';
import Smartphone from '@lucide/astro/icons/smartphone';
import Sparkles from '@lucide/astro/icons/sparkles';
import Workflow from '@lucide/astro/icons/workflow';
import Fond from './Fond.astro';
import Illustration from './Illustration.astro';

// Les huit pôles de services, sur deux lignes.
const icones = [Globe, AppWindow, Smartphone, Cloud, Sparkles, Workflow, ChartColumn, ServerCog];
const couleurs: Record<number, { fond: string; texte: string }> = {
  0: { fond: 'fill-brand-600', texte: 'text-white' },
  4: { fond: 'fill-brand-600', texte: 'text-white' },
  7: { fond: 'fill-emerald-500', texte: 'text-white' },
};
const tuiles = icones.map((Icone, index) => ({
  Icone,
  x: 36 + (index % 4) * 108,
  y: 84 + Math.floor(index / 4) * 108,
  ...(couleurs[index] ?? { fond: 'fill-white', texte: 'text-brand-600' }),
}));
---

<Illustration>
  <Fond />
  {tuiles.map(({ x, y, Icone, fond, texte }) => (
    <>
      <rect
        x={x}
        y={y}
        width="84"
        height="84"
        rx="16"
        class={`${fond} stroke-slate-300`}
        stroke-width="2"
      />
      <g class={texte}>
        <Icone x={x + 22} y={y + 22} size={40} />
      </g>
    </>
  ))}
</Illustration>
