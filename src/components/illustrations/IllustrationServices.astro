---
import Globe from '@lucide/astro/icons/globe';
import ServerCog from '@lucide/astro/icons/server-cog';
import Smartphone from '@lucide/astro/icons/smartphone';
import Workflow from '@lucide/astro/icons/workflow';
import Fond from './Fond.astro';
import Illustration from './Illustration.astro';

// Les quatre pôles de services.
const tuiles = [
  { x: 80, y: 60, Icone: Globe, fond: 'fill-brand-600', texte: 'text-white' },
  { x: 250, y: 60, Icone: Smartphone, fond: 'fill-white', texte: 'text-brand-600' },
  { x: 80, y: 190, Icone: Workflow, fond: 'fill-white', texte: 'text-brand-600' },
  { x: 250, y: 190, Icone: ServerCog, fond: 'fill-emerald-500', texte: 'text-white' },
];
---

<Illustration>
  <Fond />
  {tuiles.map(({ x, y, Icone, fond, texte }) => (
    <>
      <rect
        x={x}
        y={y}
        width="150"
        height="110"
        rx="18"
        class={`${fond} stroke-slate-300`}
        stroke-width="2"
      />
      <g class={texte}>
        <Icone x={x + 51} y={y + 31} size={48} />
      </g>
    </>
  ))}
</Illustration>
