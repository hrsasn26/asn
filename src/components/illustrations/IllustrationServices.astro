---
import AppWindow from '@lucide/astro/icons/app-window';
import ChartColumn from '@lucide/astro/icons/chart-column';
import Cloud from '@lucide/astro/icons/cloud';
import Globe from '@lucide/astro/icons/globe';
import ServerCog from '@lucide/astro/icons/server-cog';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Smartphone from '@lucide/astro/icons/smartphone';
import Sparkles from '@lucide/astro/icons/sparkles';
import Workflow from '@lucide/astro/icons/workflow';
import { couleurDuService } from '~/data/couleurs';
import { services } from '~/data/navigation';
import Fond from './Fond.astro';
import Illustration from './Illustration.astro';

// Les neuf pôles de services, sur trois lignes, chacun dans sa couleur.
const icones = [
  Globe,
  AppWindow,
  Smartphone,
  Cloud,
  Sparkles,
  Workflow,
  ChartColumn,
  ShieldCheck,
  ServerCog,
];
// Délai de chaque tuile : la vague part du coin haut gauche.
const delais = [
  'delai-0',
  'delai-100',
  'delai-200',
  'delai-100',
  'delai-200',
  'delai-300',
  'delai-200',
  'delai-300',
  'delai-400',
];
const tuiles = icones.map((Icone, index) => ({
  Icone,
  delai: delais[index],
  x: 134 + (index % 3) * 76,
  y: 74 + Math.floor(index / 3) * 76,
  fond: couleurDuService(services[index]?.href ?? '').remplissage,
}));
---

<Illustration>
  <Fond />
  {tuiles.map(({ x, y, Icone, fond, delai }) => (
    <g class:list={['anim-zoom', delai]}>
      <rect x={x} y={y} width="60" height="60" rx="12" class={fond} />
      <g class="text-white">
        <Icone x={x + 14} y={y + 14} size={32} />
      </g>
    </g>
  ))}
</Illustration>
