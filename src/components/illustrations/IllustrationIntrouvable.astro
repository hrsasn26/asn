---
import Compass from '@lucide/astro/icons/compass';
import Fond from './Fond.astro';
import Illustration from './Illustration.astro';
---

<Illustration>
  <Fond />
  <circle
    cx="240"
    cy="180"
    r="100"
    class="anim-zoom fill-white stroke-slate-300"
    stroke-width="2"
  ></circle>
  <g class="anim-tourne text-brand-600 delai-200">
    <g class="anim-cherche delai-1400">
      <Compass x={170} y={110} size={140} stroke-width={1.4} />
    </g>
  </g>
</Illustration>
