---
/**
 * Conteneur des illustrations. Elles sont décoratives : les technologies
 * d'assistance les ignorent (aria-hidden).
 */
interface Props {
  class?: string;
}

const { class: classe } = Astro.props;
---

<svg
  viewBox="0 0 480 360"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
  class:list={['h-auto w-full', classe]}
>
  <slot />
</svg>
