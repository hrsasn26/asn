---
import CreditCard from '@lucide/astro/icons/credit-card';
import UserRound from '@lucide/astro/icons/user-round';
import Navigateur from './Navigateur.astro';
import Fond from './Fond.astro';
import Illustration from './Illustration.astro';

// Un logiciel en ligne : trois formules d'abonnement et des comptes clients séparés.
const formules = [
  { x: 56, miseEnAvant: false },
  { x: 146, miseEnAvant: true },
  { x: 236, miseEnAvant: false },
];
const comptes = [
  { y: 86, pastille: 'fill-brand-600' },
  { y: 156, pastille: 'fill-emerald-500' },
  { y: 226, pastille: 'fill-slate-800' },
];
---

<Illustration>
  <Fond />
  <Navigateur x={40} y={56} largeur={300} hauteur={220}>
    <rect x="56" y="98" width="120" height="8" rx="4" class="fill-slate-800"></rect>
    {formules.map(({ x, miseEnAvant }) => (
      <>
        <rect
          x={x}
          y="118"
          width="78"
          height="120"
          rx="10"
          class={miseEnAvant ? 'fill-brand-50 stroke-brand-600' : 'fill-white stroke-slate-300'}
          stroke-width="2"
        />
        <rect x={x + 12} y="132" width="36" height="6" rx="3" class="fill-slate-300" />
        <rect x={x + 12} y="148" width="48" height="12" rx="4" class="fill-slate-800" />
        {[172, 184, 196].map((y) => (
          <rect x={x + 12} y={y} width="54" height="5" rx="2.5" class="fill-slate-200" />
        ))}
        <rect
          x={x + 12}
          y="212"
          width="54"
          height="14"
          rx="7"
          class={miseEnAvant ? 'fill-brand-600' : 'fill-brand-100'}
        />
      </>
    ))}
  </Navigateur>

  <rect
    x="150"
    y="258"
    width="150"
    height="44"
    rx="12"
    class="fill-white stroke-slate-300"
    stroke-width="2"
  ></rect>
  <g class="text-brand-600">
    <CreditCard x={164} y={268} size={24} />
  </g>
  <rect x="198" y="272" width="80" height="6" rx="3" class="fill-slate-800"></rect>
  <rect x="198" y="284" width="52" height="5" rx="2.5" class="fill-emerald-500"></rect>

  {comptes.map(({ y, pastille }) => (
    <>
      <rect
        x="356"
        y={y}
        width="88"
        height="56"
        rx="12"
        class="fill-white stroke-slate-300"
        stroke-width="2"
      />
      <circle cx="378" cy={y + 28} r="12" class={pastille} />
      <g class="text-white">
        <UserRound x={370} y={y + 20} size={16} />
      </g>
      <rect x="396" y={y + 20} width="38" height="6" rx="3" class="fill-slate-800" />
      <rect x="396" y={y + 32} width="26" height="5" rx="2.5" class="fill-slate-200" />
    </>
  ))}
</Illustration>
