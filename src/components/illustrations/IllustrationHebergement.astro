---
import Clock from '@lucide/astro/icons/clock';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Fond from './Fond.astro';
import Illustration from './Illustration.astro';
---

<Illustration>
  <Fond />
  {[80, 150, 220].map((y) => (
    <>
      <rect
        x="70"
        y={y}
        width="210"
        height="56"
        rx="12"
        class="fill-white stroke-slate-300"
        stroke-width="2"
      />
      <circle cx="96" cy={y + 28} r="7" class="fill-emerald-500" />
      <circle cx="118" cy={y + 28} r="7" class="fill-brand-100" />
      <rect x="150" y={y + 18} width="110" height="7" rx="3.5" class="fill-slate-200" />
      <rect x="150" y={y + 32} width="80" height="7" rx="3.5" class="fill-slate-200" />
    </>
  ))}
  <rect x="120" y="286" width="110" height="10" rx="5" class="fill-slate-300"></rect>
  <circle cx="358" cy="130" r="58" class="fill-brand-600"></circle>
  <g class="text-white">
    <ShieldCheck x={326} y={98} size={64} stroke-width={1.8} />
  </g>
  <rect
    x="300"
    y="210"
    width="140"
    height="84"
    rx="14"
    class="fill-white stroke-slate-300"
    stroke-width="2"
  ></rect>
  <g class="text-brand-600">
    <Clock x={314} y={226} size={28} />
  </g>
  <rect x="352" y="232" width="72" height="7" rx="3.5" class="fill-slate-200"></rect>
  <polyline
    points="316,278 340,268 362,274 386,258 408,262 426,250"
    fill="none"
    class="stroke-emerald-500"
    stroke-width="4"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></polyline>
</Illustration>
