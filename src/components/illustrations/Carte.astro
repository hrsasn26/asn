---
/** Carte blanche avec une icône centrée et une ligne de texte simulée. */
interface Props {
  x: number;
  y: number;
  largeur?: number;
  hauteur?: number;
}

const { x, y, largeur = 90, hauteur = 80 } = Astro.props;
---

<rect
  x={x}
  y={y}
  width={largeur}
  height={hauteur}
  rx="14"
  class="fill-white stroke-slate-300"
  stroke-width="2"
></rect>
<g class="text-brand-600">
  <slot />
</g>
<rect
  x={x + largeur / 2 - 24}
  y={y + hauteur - 20}
  width="48"
  height="6"
  rx="3"
  class="fill-slate-200"
></rect>
