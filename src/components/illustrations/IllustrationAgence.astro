---
import Fond from './Fond.astro';
import Illustration from './Illustration.astro';

// Silhouettes neutres : aucune personne réelle n'est représentée.
const personnes = [
  { x: 130, couleur: 'fill-brand-600', delai: 'delai-150' },
  { x: 240, couleur: 'fill-emerald-500', delai: 'delai-300' },
  { x: 350, couleur: 'fill-amber-400', delai: 'delai-450' },
];
---

<Illustration>
  <Fond />
  {personnes.map(({ x, couleur, delai }) => (
    <g class:list={['anim-entree', delai]}>
      <circle cx={x} cy="120" r="30" class="fill-slate-300" />
      <path d={`M${x - 52} 236a52 52 0 0 1 104 0v8H${x - 52}z`} class={couleur} />
    </g>
  ))}
  <rect x="60" y="244" width="360" height="14" rx="7" class="anim-ecrit fill-slate-800"></rect>
  <g class="anim-zoom delai-900">
    <rect
      x="300"
      y="54"
      width="120"
      height="44"
      rx="14"
      class="fill-white stroke-slate-300"
      stroke-width="2"
    ></rect>
    <circle cx="324" cy="76" r="10" class="fill-emerald-500"></circle>
    <rect
      x="342"
      y="72"
      width="62"
      height="8"
      rx="4"
      class="anim-ecrit fill-slate-200 puis-300"
    ></rect>
  </g>
</Illustration>
