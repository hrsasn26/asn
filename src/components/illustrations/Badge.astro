---
/**
 * Pastille ronde avec une coche : symbole des tests réussis.
 * Animation : la pastille grandit, puis la coche se dessine. Le délai se règle avec
 * une classe delai-* (par exemple class="delai-900").
 */
interface Props {
  cx: number;
  cy: number;
  r?: number;
  class?: string;
}

const { cx, cy, r = 28, class: classe } = Astro.props;
const k = r / 28;
const coche = `M${cx - 13 * k} ${cy} l${10 * k} ${10 * k} l${17 * k} -${19 * k}`;
---

<g class:list={['anim-zoom', classe]}>
  <circle cx={cx} cy={cy} r={r} class="fill-emerald-500"></circle>
  <path
    d={coche}
    pathLength="1"
    fill="none"
    class="anim-trace stroke-white puis-350"
    stroke-width={6 * k}
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
</g>
