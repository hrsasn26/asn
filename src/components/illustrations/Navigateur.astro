---
/**
 * Fenêtre de navigateur vide, à placer dans une illustration (unités du viewBox).
 * La classe (par exemple "anim-entree") s'applique à la fenêtre et à son contenu.
 */
interface Props {
  x: number;
  y: number;
  largeur: number;
  hauteur: number;
  class?: string;
}

const { x, y, largeur, hauteur, class: classe } = Astro.props;
const barre = `M${x} ${y + 14}a14 14 0 0 1 14-14h${largeur - 28}a14 14 0 0 1 14 14v18H${x}z`;
---

<g class={classe}>
  <rect
    x={x}
    y={y}
    width={largeur}
    height={hauteur}
    rx="14"
    class="fill-white stroke-slate-300"
    stroke-width="2"
  ></rect>
  <path d={barre} class="fill-slate-100"></path>
  <circle cx={x + 18} cy={y + 16} r="4" class="fill-rose-300"></circle>
  <circle cx={x + 32} cy={y + 16} r="4" class="fill-amber-300"></circle>
  <circle cx={x + 46} cy={y + 16} r="4" class="fill-emerald-300"></circle>
  <slot />
</g>
