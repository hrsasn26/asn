---
import Tag from '@lucide/astro/icons/tag';
import Fond from './Fond.astro';
import Illustration from './Illustration.astro';
---

<Illustration>
  <Fond />
  <rect
    x="100"
    y="50"
    width="200"
    height="260"
    rx="14"
    class="fill-white stroke-slate-300"
    stroke-width="2"
  ></rect>
  <rect x="124" y="78" width="100" height="12" rx="6" class="fill-slate-800"></rect>
  <rect x="124" y="98" width="70" height="7" rx="3.5" class="fill-slate-200"></rect>
  {[130, 164, 198].map((y) => (
    <>
      <circle cx="134" cy={y + 6} r="8" class="fill-emerald-500" />
      <rect x="152" y={y} width="90" height="7" rx="3.5" class="fill-slate-200" />
      <rect x="152" y={y + 10} width="60" height="5" rx="2.5" class="fill-slate-100" />
    </>
  ))}
  <line x1="124" y1="238" x2="276" y2="238" class="stroke-slate-200" stroke-width="2"></line>
  <rect x="124" y="254" width="60" height="8" rx="4" class="fill-slate-300"></rect>
  <rect x="206" y="250" width="70" height="16" rx="8" class="fill-brand-600"></rect>
  <circle cx="352" cy="150" r="64" class="fill-brand-600"></circle>
  <g class="text-white">
    <Tag x={320} y={118} size={64} stroke-width={1.8} />
  </g>
</Illustration>
