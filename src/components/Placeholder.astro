---
/**
 * Bloc de contenu à rédiger, surligné en jaune comme les autres placeholders.
 * Le texte doit rester entre crochets : `pnpm check:content --strict` bloque la mise en
 * production tant qu'il en reste.
 */
interface Props {
  text: string;
  class?: string;
}

const { text, class: classe } = Astro.props;
---

<p class:list={['leading-[1.75]', classe]}>
  <span class="a-completer">{text}</span>
</p>
