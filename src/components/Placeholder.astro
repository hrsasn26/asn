---
/**
 * Bloc de contenu à rédiger. Le texte doit rester entre crochets :
 * `pnpm check:content --strict` bloque la mise en production tant qu'il en reste.
 */
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<p class="rounded-md border-2 border-dashed border-amber-400 bg-amber-50 px-4 py-3 text-amber-900">
  {text}
</p>
