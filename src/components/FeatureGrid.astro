---
import type { AstroComponent } from '@lucide/astro';

export interface Feature {
  title: string;
  text: string;
  /** Icône décorative (Lucide), affichée au-dessus du titre. */
  icone?: AstroComponent;
}

interface Props {
  items: Feature[];
  columns?: 2 | 3 | 4;
}

const { items, columns = 2 } = Astro.props;
---

<div
  class:list={[
    'grid gap-6',
    columns === 2 && 'md:grid-cols-2',
    columns === 3 && 'md:grid-cols-3',
    columns === 4 && 'md:grid-cols-2 lg:grid-cols-4',
  ]}
>
  {items.map(({ title, text, icone: Icone }) => (
    <div class="rounded-lg border border-slate-200 bg-white p-6">
      {Icone && (
        <span class="mb-4 inline-flex size-11 items-center justify-center rounded-lg bg-brand-50 text-brand-700">
          <Icone size={24} />
        </span>
      )}
      <h3 class="text-lg">{title}</h3>
      <p class="mt-2 text-slate-700">{text}</p>
    </div>
  ))}
</div>
