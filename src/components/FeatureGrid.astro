---
/**
 * Grille d'avantages (maquettes), en une à trois colonnes selon la place disponible.
 * - traits : un trait court au-dessus de chaque titre, sans cadre ;
 * - cartes : chaque élément dans une carte à bordure fine.
 * Avec `titresEnLigne`, le titre est le début de la phrase, en gras (« **Tout tester** avant… ») :
 * `text` commence alors par la suite de la phrase (espace ou ponctuation comprise).
 */
import Texte from '~/components/Texte.astro';

export interface Feature {
  title: string;
  text: string;
}

interface Props {
  items: Feature[];
  variante?: 'traits' | 'cartes';
  /** Largeur minimale d'une colonne, en pixels. */
  min?: 220 | 240 | 300 | 400;
  titresEnLigne?: boolean;
}

const { items, variante = 'traits', min = 300, titresEnLigne = false } = Astro.props;
---

<div
  class:list={[
    'grid',
    min === 400 && 'grid-cols-[repeat(auto-fit,minmax(min(100%,25rem),1fr))]',
    min === 300 && 'grid-cols-[repeat(auto-fit,minmax(min(100%,18.75rem),1fr))]',
    min === 240 && 'grid-cols-[repeat(auto-fit,minmax(min(100%,15rem),1fr))]',
    min === 220 && 'grid-cols-[repeat(auto-fit,minmax(min(100%,13.75rem),1fr))]',
    // Écarts des maquettes : 56 px (colonnes larges), 48 px (240 px), 40 px (220 px).
    variante === 'traits' && min >= 300 && 'gap-x-14 gap-y-12',
    variante === 'traits' && min === 240 && 'gap-x-12 gap-y-10',
    variante === 'traits' && min === 220 && 'gap-10',
    variante === 'cartes' && 'gap-6',
  ]}
>
  {items.map(({ title, text }) =>
    variante === 'cartes' ? (
      <article class="apparition flex min-w-0 flex-col rounded-3xl px-7 py-8 ring-1 ring-ligne ring-inset">
        <h3 class="text-[1.375rem] tracking-[-0.02em]">{title}</h3>
        <p class="mt-3 leading-[1.65] text-doux">
          <Texte texte={text} />
        </p>
      </article>
    ) : (
      <div class="apparition min-w-0">
        <div aria-hidden="true" class="h-px w-10 bg-encre" />
        {titresEnLigne ? (
          <p class="mt-5.5 leading-[1.65] text-fonce sm:text-[1.0625rem]">
            {/* Astro n'ajoute pas d'espace entre le titre et la suite : `text` porte la sienne. */}
            <strong class="font-semibold text-encre">{title}</strong>
            <Texte texte={text} />
          </p>
        ) : (
          <>
            <h3 class="mt-5.5 text-lg sm:text-[1.1875rem]">{title}</h3>
            <p class="mt-2.5 leading-[1.65] text-doux">
              <Texte texte={text} />
            </p>
          </>
        )}
      </div>
    ),
  )}
</div>
