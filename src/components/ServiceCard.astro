---
interface Props {
  title: string;
  text: string;
  items: string[];
  link: { label: string; href: string };
}

const { title, text, items, link } = Astro.props;
---

<article class="flex flex-col rounded-lg border border-slate-200 bg-white p-6">
  <h3 class="text-xl">{title}</h3>
  <p class="mt-2 text-slate-700">{text}</p>
  <ul class="mt-4 list-disc space-y-1 pl-5 text-slate-700">
    {items.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
  <p class="mt-auto pt-6">
    <a href={link.href} class="font-semibold text-brand-700 hover:text-brand-800">
      {link.label}
      <span aria-hidden="true"> →</span>
    </a>
  </p>
</article>
