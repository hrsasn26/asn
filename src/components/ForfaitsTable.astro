---
import { forfaitsMaintenance } from '~/data/forfaits';
import Texte from '~/components/Texte.astro';

const lignes: { label: string; valeur: (f: (typeof forfaitsMaintenance)[number]) => string }[] = [
  { label: 'Pour qui', valeur: (f) => f.pourQui },
  { label: 'Hébergement + HTTPS', valeur: () => '✓' },
  { label: 'Sauvegardes', valeur: (f) => f.sauvegardes },
  { label: 'Surveillance 24 h/24', valeur: () => '✓' },
  { label: 'Mises à jour de sécurité', valeur: () => '✓' },
  { label: 'Modifications incluses', valeur: (f) => f.modifications },
  { label: "Délai d'intervention", valeur: (f) => f.delaiIntervention },
  { label: 'Rapport mensuel', valeur: (f) => (f.rapportMensuel ? '✓' : '—') },
];
---

{/* Sur téléphone, le tableau défile horizontalement dans son cadre. */}
<div
  class="apparition overflow-x-auto rounded-3xl ring-1 ring-ligne ring-inset"
  role="region"
  aria-label="Comparatif des forfaits"
  tabindex="0"
>
  <table class="w-full min-w-xl border-collapse text-left">
    <caption class="sr-only">Comparatif des forfaits d'hébergement et de maintenance</caption>
    <thead>
      <tr>
        <td class="p-4 sm:px-6"></td>
        {forfaitsMaintenance.map((f) => (
          <th
            scope="col"
            class:list={[
              'p-4 align-bottom text-lg font-semibold sm:px-6',
              f.recommande && 'rounded-t-2xl bg-surface',
            ]}
          >
            {/* Le nom d'abord (nom de la colonne pour les lecteurs d'écran), la pastille au-dessus. */}
            <span class="inline-flex flex-col-reverse items-start gap-2">
              <span>{f.nom}</span>
              {f.recommande && (
                <span class="rounded-full bg-encre px-2.5 py-1 text-xs font-semibold text-white">
                  recommandé
                </span>
              )}
            </span>
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {lignes.map((ligne) => (
        <tr class="border-t border-ligne">
          <th scope="row" class="p-4 text-[0.9375rem] font-semibold sm:px-6">
            {ligne.label}
          </th>
          {forfaitsMaintenance.map((f) => {
            const valeur = ligne.valeur(f);
            return (
              <td
                class:list={[
                  'p-4 text-[0.9375rem] text-doux sm:px-6',
                  f.recommande && 'bg-surface',
                ]}
              >
                {valeur === '✓' ? (
                  <>
                    <span aria-hidden="true" class="font-bold text-bleu">
                      ✓
                    </span>
                    <span class="sr-only">Inclus</span>
                  </>
                ) : valeur === '—' ? (
                  <>
                    <span aria-hidden="true">—</span>
                    <span class="sr-only">Non inclus</span>
                  </>
                ) : (
                  <Texte texte={valeur} />
                )}
              </td>
            );
          })}
        </tr>
      ))}
    </tbody>
  </table>
</div>
