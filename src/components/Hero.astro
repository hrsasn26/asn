---
/**
 * En-tête de page (maquettes). Trois mises en page :
 * - centre : accueil. Texte centré, grand titre, visuel sous les boutons ;
 * - avec `maquette` : pages de services et audit gratuit. Texte à gauche, visuel à droite
 *   (sous le texte sur téléphone) ;
 * - sans visuel : Services, Méthode, L'agence. Texte seul.
 * Les boutons sont passés dans le slot par défaut.
 */
import Accent from '~/components/Accent.astro';
import MaquetteHero from '~/components/MaquetteHero.astro';
import Texte from '~/components/Texte.astro';
import { TAILLES_MAQUETTE, type NomMaquette } from '~/data/maquettes';

interface Props {
  title: string;
  /** Partie du titre en gras. Elle doit figurer dans le titre. */
  motCle?: string;
  subtitle?: string;
  /** Petites capitales au-dessus du titre (« Service 01 · Sites web »). */
  surtitre?: string;
  /** Maquette d'écrans (src/data/maquettes.ts), avec la légende « Exemple fictif ». */
  maquette?: NomMaquette;
  /** Texte centré et titre plus grand (accueil). */
  centre?: boolean;
}

const { title, motCle, subtitle, surtitre, maquette, centre = false } = Astro.props;
const avecBoutons = Astro.slots.has('default');
const enColonnes = maquette !== undefined && !centre;
---

<section
  class:list={[
    // Accueil (sans fil d'Ariane) : le fond gris descend jusqu'au visuel.
    centre && 'bg-linear-to-b from-surface to-white to-70%',
  ]}
>
  <div
    class:list={[
      'conteneur',
      centre && 'flex flex-col items-center pt-20 text-center sm:pt-28',
      enColonnes && 'flex flex-wrap items-center gap-x-16 gap-y-12 pt-12 sm:pt-14',
      !centre && !enColonnes && 'pt-12 sm:pt-14',
    ]}
  >
    <div class:list={[enColonnes && 'min-w-0 flex-[1_1_26.25rem]']}>
      {surtitre && <p class="anim-montee surtitre text-discret">{surtitre}</p>}
      <h1
        class:list={[
          'anim-montee',
          surtitre && (centre ? 'mt-7' : 'mt-5'),
          centre && 'max-w-[61.25rem] text-accroche',
          enColonnes && 'text-titre-service',
          !centre && !enColonnes && 'max-w-[56.25rem] text-titre',
        ]}
      >
        <Accent texte={title} motCle={motCle} />
      </h1>
      {subtitle && (
        <p
          class:list={[
            'anim-montee mt-7 text-lg leading-[1.65] text-texte delai-150 sm:text-[1.1875rem]',
            enColonnes ? 'max-w-[32.5rem]' : 'max-w-[40rem]',
            centre && 'mx-auto',
          ]}
        >
          <Texte texte={subtitle} />
        </p>
      )}
      {avecBoutons && (
        <div
          class:list={[
            'anim-montee flex flex-wrap gap-3 delai-300',
            centre ? 'mt-10 justify-center' : 'mt-9',
          ]}
        >
          <slot />
        </div>
      )}
    </div>
    {maquette && (
      <MaquetteHero
        nom={maquette}
        sizes={centre ? TAILLES_MAQUETTE.centre : TAILLES_MAQUETTE.colonne}
        prioritaire
        class:list={[
          'anim-montee delai-300',
          centre
            ? 'mt-16 w-full max-w-[65rem] sm:mt-20'
            : 'max-w-full min-w-0 flex-[1.2_1_28.75rem]',
        ]}
      />
    )}
  </div>
</section>
