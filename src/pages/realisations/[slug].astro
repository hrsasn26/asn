---
import { getCollection, render } from 'astro:content';
import Prose from '~/components/Prose.astro';
import Section from '~/components/Section.astro';
import { site } from '~/data/site';
import BaseLayout from '~/layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const etudes = await getCollection('realisations', ({ data }) => !data.draft);
  return etudes.map((etude) => ({ params: { slug: etude.id }, props: { etude } }));
}

const { etude } = Astro.props;
const { Content } = await render(etude);
---

<BaseLayout
  title={`${etude.data.title} | ${site.nom}`}
  description={etude.data.description}
  breadcrumbs={[
    { label: 'Réalisations', href: '/realisations' },
    { label: etude.data.title, href: `/realisations/${etude.id}` },
  ]}
>
  <Section>
    <article>
      <h1 class="text-3xl sm:text-4xl">{etude.data.title}</h1>
      <p class="mt-2 text-slate-600">{etude.data.client}</p>
      <div class="mt-8">
        <Prose>
          <Content />
        </Prose>
      </div>
    </article>
  </Section>
</BaseLayout>
