---
import BookOpen from '@lucide/astro/icons/book-open';
import { getCollection } from 'astro:content';
import Section from '~/components/Section.astro';
import Souligne from '~/components/Souligne.astro';
import { couleurPalette } from '~/data/couleurs';
import { site } from '~/data/site';
import BaseLayout from '~/layouts/BaseLayout.astro';

const articles = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const formatDate = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long' });
---

<BaseLayout
  title={`Blog : conseils pour votre site web et vos outils numériques | ${site.nom}`}
  description="Des conseils pratiques et sans jargon pour créer, entretenir et faire connaître votre site web."
  breadcrumbs={[{ label: 'Blog', href: '/blog' }]}
>
  <Section>
    <h1 class="anim-montee text-3xl sm:text-4xl">
      <Souligne>Blog</Souligne>
    </h1>
    <p class="anim-montee mt-4 max-w-2xl text-lg text-slate-700 delai-150">
      Des conseils pratiques et sans jargon pour créer, entretenir et faire connaître votre site
      web.
    </p>
    {articles.length === 0 ? (
      <p class="mt-6 text-slate-700">Aucun article pour l'instant.</p>
    ) : (
      <ul class="mt-8 grid gap-6">
        {articles.map((article, index) => (
          <li class="group apparition flex items-start gap-4 rounded-lg border border-slate-200 p-6 transition hover:border-slate-300 hover:shadow-lg motion-safe:hover:-translate-y-1">
            {/* Chaque article a une couleur de la palette. L'icône s'incline au survol. */}
            <span
              aria-hidden="true"
              class:list={[
                'inline-flex size-11 shrink-0 items-center justify-center rounded-lg transition-transform motion-safe:group-hover:scale-110 motion-safe:group-hover:-rotate-6',
                couleurPalette(index).douce,
              ]}
            >
              <BookOpen size={22} />
            </span>
            <div>
              <h2 class="text-xl">
                <a href={`/blog/${article.id}`} class="text-slate-900 hover:text-brand-700">
                  {article.data.title}
                </a>
              </h2>
              <p class="mt-1 text-sm text-slate-600">
                <time datetime={article.data.publishedAt.toISOString()}>
                  {formatDate.format(article.data.publishedAt)}
                </time>
              </p>
              <p class="mt-2 text-slate-700">{article.data.description}</p>
            </div>
          </li>
        ))}
      </ul>
    )}
  </Section>
</BaseLayout>
