---
// Textes : docs/brief-agence.md, section 6.7 (proposition à valider).
// Surtitres des sections : section 6.20 du brief.
import AuditTeaser from '~/components/AuditTeaser.astro';
import ButtonLink from '~/components/ButtonLink.astro';
import CtaFinal from '~/components/CtaFinal.astro';
import FeatureGrid from '~/components/FeatureGrid.astro';
import Hero from '~/components/Hero.astro';
import LienFleche from '~/components/LienFleche.astro';
import ListePoints from '~/components/ListePoints.astro';
import Section from '~/components/Section.astro';
import ServiceCards from '~/components/ServiceCards.astro';
import Steps from '~/components/Steps.astro';
import { etapesProjet } from '~/data/processus';
import { cta, site } from '~/data/site';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { organisationJsonLd, siteWebJsonLd } from '~/lib/seo';

const description =
  'Nous créons, testons, hébergeons et maintenons vos sites et vos applications. Un interlocuteur direct, un devis à prix fixe et un suivi après la mise en ligne.';
---

<BaseLayout
  title={`Sites web et applications sur mesure | ${site.nom}`}
  {description}
  jsonLd={{
    '@graph': [
      organisationJsonLd(Astro.site ?? Astro.url.origin, description),
      siteWebJsonLd(Astro.site ?? Astro.url.origin),
    ],
  }}
>
  <Hero
    centre
    maquette="accueil"
    title="Des sites et des applications fiables, suivis dans la durée"
    motCle="suivis dans la durée"
    subtitle="Sites web, applications et automatisations : nous concevons des outils rapides, sécurisés et faciles à faire évoluer. Et nous restons disponibles après la mise en ligne."
  >
    <ButtonLink href={cta.principal.href}>{cta.principal.label}</ButtonLink>
    <ButtonLink href={cta.secondaire.href} variant="secondaire">
      {cta.secondaire.label}
    </ButtonLink>
  </Hero>

  <Section surtitre="Vos bénéfices" title="Ce que vous y gagnez" disposition="colonnes">
    <p class="apparition mb-12 text-lg leading-[1.7] text-doux">
      Un projet qui fonctionne dès le lancement, qui reste facile à faire évoluer et qui ne vous
      rend pas dépendant d'un prestataire.
    </p>
    <FeatureGrid
      items={[
        {
          title: 'Surveillé et sauvegardé',
          text: 'Hébergement surveillé, sauvegardes et maintenance pour limiter les interruptions.',
        },
        {
          title: 'Testé avant la mise en ligne',
          text: 'Pages, formulaires, parcours et affichage sur mobile sont vérifiés avant la mise en ligne.',
        },
        {
          title: 'Conçu pour évoluer',
          text: 'Une base technique propre pour ajouter des fonctionnalités sans repartir de zéro.',
        },
        {
          title: 'Un interlocuteur direct',
          text: "Vous échangez avec l'équipe qui conçoit et développe votre projet.",
        },
      ]}
    />
  </Section>

  <Section
    surtitre="Nos services"
    title="Des solutions digitales qui répondent à vos enjeux"
    disposition="centre"
  >
    <ServiceCards />
  </Section>

  <Section surtitre="Processus" title="Un projet en cinq étapes claires" disposition="centre">
    <Steps items={etapesProjet} />
    <p class="apparition mt-12 text-center">
      <LienFleche href="/processus" label="Découvrir notre processus" />
    </p>
  </Section>

  <AuditTeaser maquette />

  <Section surtitre="Engagements" title="Nos engagements" disposition="colonnes">
    <ListePoints
      variante="grille"
      items={[
        'Vous restez propriétaire de votre code, de votre nom de domaine et de vos données.',
        'Un périmètre, un prix fixe et un planning écrits avant de commencer.',
        'Des tests avant chaque mise en ligne.',
      ]}
    />
  </Section>

  <CtaFinal
    title="Parlons de votre projet"
    motCle="projet"
    text="Un échange de 30 minutes, gratuit et sans engagement, pour comprendre votre besoin et vous dire honnêtement ce que nous pouvons faire pour vous."
    button={cta.principal}
  />
</BaseLayout>
