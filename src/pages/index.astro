---
// Textes : docs/brief-agence.md, section 6.7 (proposition à valider).
import Activity from '@lucide/astro/icons/activity';
import BadgeCheck from '@lucide/astro/icons/badge-check';
import Blocks from '@lucide/astro/icons/blocks';
import Handshake from '@lucide/astro/icons/handshake';
import { getCollection } from 'astro:content';
import AuditTeaser from '~/components/AuditTeaser.astro';
import ButtonLink from '~/components/ButtonLink.astro';
import CtaFinal from '~/components/CtaFinal.astro';
import FeatureGrid from '~/components/FeatureGrid.astro';
import Hero from '~/components/Hero.astro';
import IllustrationAccueil from '~/components/illustrations/IllustrationAccueil.astro';
import Placeholder from '~/components/Placeholder.astro';
import PourQui from '~/components/PourQui.astro';
import Section from '~/components/Section.astro';
import ServiceCards from '~/components/ServiceCards.astro';
import Steps from '~/components/Steps.astro';
import { etapesProjet } from '~/data/methode';
import { cta, site } from '~/data/site';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { organisationJsonLd } from '~/lib/seo';

const realisations = (await getCollection('realisations', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);
---

<BaseLayout
  title={`Sites web et applications sur mesure pour TPE, PME et particuliers | ${site.nom}`}
  description="Nous créons, testons, hébergeons et maintenons vos sites et vos applications. Une équipe d'ingénieurs, un seul interlocuteur et un devis à prix fixe."
  jsonLd={organisationJsonLd(Astro.site ?? Astro.url.origin)}
>
  <Hero
    title="Des sites et des applications conçus par des ingénieurs"
    motCle="ingénieurs"
    subtitle="Fiables, testés, sécurisés et suivis dans la durée. Nous construisons votre projet, puis nous nous en occupons, pour que vous puissiez vous concentrer sur votre activité."
  >
    <ButtonLink href={cta.principal.href}>{cta.principal.label}</ButtonLink>
    <ButtonLink href={cta.secondaire.href} variant="secondaire">
      {cta.secondaire.label}
    </ButtonLink>
    <IllustrationAccueil slot="illustration" />
  </Hero>

  <Section title="Ce que vous y gagnez">
    <FeatureGrid
      columns={4}
      items={[
        {
          title: 'Toujours en ligne',
          text: 'Votre site reste en ligne, rapide et sauvegardé automatiquement.',
          icone: Activity,
        },
        {
          title: 'Testé avant la mise en ligne',
          text: 'Tout est vérifié sur ordinateur, tablette et mobile avant la mise en ligne. Pas de mauvaise surprise.',
          icone: BadgeCheck,
        },
        {
          title: 'Construit pour durer',
          text: 'Un outil solide, qui évolue avec votre activité sans tout reconstruire.',
          icone: Blocks,
        },
        {
          title: 'Un seul interlocuteur',
          text: 'Les personnes qui construisent votre projet sont celles qui vous répondent, du premier échange à la maintenance.',
          icone: Handshake,
        },
      ]}
    />
  </Section>

  <Section title="Ce que nous faisons pour vous" tone="gris">
    <ServiceCards />
  </Section>

  <PourQui tone="clair" />

  <Section title="Un projet en cinq étapes claires" tone="gris">
    <Steps items={etapesProjet} />
    <p class="mt-8">
      <a href="/methode" class="font-semibold text-brand-700 hover:text-brand-800">
        Découvrir notre méthode<span aria-hidden="true"> →</span>
      </a>
    </p>
  </Section>

  <Section title="Nos réalisations">
    {realisations.length === 0 ? (
      <div class="max-w-3xl">
        <Placeholder text="[À compléter : 2 ou 3 études de cas réelles, avec l'accord des clients]" />
      </div>
    ) : (
      <ul class="grid gap-6 md:grid-cols-3">
        {realisations.map((etude) => (
          <li class="apparition rounded-lg border border-slate-200 p-6 transition hover:border-slate-300 hover:shadow-lg motion-safe:hover:-translate-y-1">
            <h3 class="text-lg">
              <a href={`/realisations/${etude.id}`} class="text-slate-900 hover:text-brand-700">
                {etude.data.title}
              </a>
            </h3>
            <p class="mt-1 text-sm text-slate-600">{etude.data.client}</p>
            <p class="mt-2 text-slate-700">{etude.data.description}</p>
          </li>
        ))}
      </ul>
    )}
    <p class="mt-8">
      <a href="/realisations" class="font-semibold text-brand-700 hover:text-brand-800">
        Voir nos réalisations<span aria-hidden="true"> →</span>
      </a>
    </p>
  </Section>

  <AuditTeaser tone="gris" />

  <Section title="Nos engagements">
    <ul class="grid max-w-3xl gap-3">
      {[
        'Vous restez propriétaire de votre code, de votre nom de domaine et de vos données.',
        'Un devis à prix fixe, après un échange gratuit.',
        `Une réponse à votre demande sous ${site.delaiReponse}.`,
        `Un hébergement en ${site.hebergement}.`,
      ].map((engagement) => (
        <li class="apparition flex gap-3 rounded-md border border-slate-200 bg-white px-4 py-3">
          <BadgeCheck class="mt-0.5 shrink-0 text-emerald-600" size={20} />
          <span>{engagement}</span>
        </li>
      ))}
    </ul>
  </Section>

  <CtaFinal
    title="Parlons de votre projet"
    text="Un échange de 30 minutes, gratuit et sans engagement, pour comprendre votre besoin et vous dire honnêtement ce que nous pouvons faire pour vous."
    button={cta.principal}
  />
</BaseLayout>
