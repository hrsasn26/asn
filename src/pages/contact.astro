---
// Textes : docs/brief-agence.md, section 6.11 (proposition à valider). Surtitres : section 6.20.
import { actions } from 'astro:actions';
import Accent from '~/components/Accent.astro';
import ButtonLink from '~/components/ButtonLink.astro';
import Encadre from '~/components/Encadre.astro';
import CarteFormulaire from '~/components/forms/CarteFormulaire.astro';
import Consent from '~/components/forms/Consent.astro';
import ErrorSummary from '~/components/forms/ErrorSummary.astro';
import Field from '~/components/forms/Field.astro';
import Honeypot from '~/components/forms/Honeypot.astro';
import Success from '~/components/forms/Success.astro';
import Section from '~/components/Section.astro';
import Texte from '~/components/Texte.astro';
import { cta, site } from '~/data/site';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { etatFormulaire } from '~/lib/formulaire';
import { estConfirme } from '~/lib/placeholders';
import { typesProjet } from '~/lib/schemas';

export const prerender = false;

const etat = await etatFormulaire(Astro.getActionResult(actions.contact), Astro.request, [
  'nom',
  'email',
  'telephone',
  'projet',
  'message',
  'consentement',
]);
const projetChoisi = etat.valeur('projet') ?? '';
const titre = `Contact et demande de devis gratuit | ${site.nom}`;

const ensuite = [
  'Nous étudions votre demande.',
  'Si nécessaire, nous organisons un appel gratuit pour mieux comprendre votre besoin.',
  'Vous recevez un devis clair, à prix fixe, sans engagement.',
];

// Une coordonnée encore entre crochets n'est pas affichée : le téléphone apparaît quand le
// numéro remplace le placeholder dans src/data/site.ts (section 6.11 du brief).
const coordonnees = [
  { label: 'E-mail', valeur: site.email, href: `mailto:${site.email}` },
  { label: 'Téléphone', valeur: site.telephone },
].filter(({ valeur }) => estConfirme(valeur));
---

<BaseLayout
  title={etat.enErreur ? `Erreur : ${titre}` : titre}
  description="Décrivez votre projet en quelques lignes : nous revenons vers vous avec les prochaines étapes. Échange gratuit et sans engagement."
  breadcrumbs={[{ label: 'Contact', href: '/contact' }]}
>
  <section class="conteneur flex flex-wrap items-start gap-x-20 gap-y-12 pt-12 sm:pt-14">
    <div class="min-w-0 flex-[1_1_21.25rem]">
      <h1 class="anim-montee text-titre [text-wrap:wrap]">
        <Accent texte="Parlons de votre projet" motCle="projet" />
      </h1>
      <p class="anim-montee mt-7 max-w-[28.75rem] text-lg leading-[1.65] text-texte delai-150 sm:text-[1.1875rem]">
        Expliquez-nous votre besoin en quelques lignes. Nous vous répondons avec les prochaines
        étapes et, lorsque c'est possible, une première orientation sur le périmètre.
      </p>

      <div class="anim-montee mt-14 delai-300">
        <h2 class="surtitre text-discret">Et ensuite ?</h2>
        <ol class="mt-5 flex max-w-[28.75rem] flex-col gap-5">
          {ensuite.map((etape, index) => (
            <li class="flex gap-4.5">
              <span
                aria-hidden="true"
                class:list={[
                  'grid size-8 shrink-0 place-items-center rounded-full text-[0.8125rem] font-semibold',
                  index === ensuite.length - 1
                    ? 'bg-encre text-white'
                    : 'ring-1 ring-encre ring-inset',
                ]}
              >
                {index + 1}
              </span>
              <span class="pt-1 leading-[1.6] text-fonce">
                <Texte texte={etape} />
              </span>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <CarteFormulaire class="max-w-full min-w-0 flex-[1.2_1_27.5rem]">
      {etat.envoye ? (
        <Success title="Votre demande est envoyée">
          <p>Nous revenons vers vous avec les prochaines étapes.</p>
        </Success>
      ) : (
        <form
          method="POST"
          action={actions.contact}
          novalidate
          class="relative flex flex-col gap-5"
        >
          <ErrorSummary errors={etat.resume} message={etat.messageGeneral} />
          <div class="flex flex-wrap gap-5">
            <Field
              name="nom"
              label="Nom"
              required
              autocomplete="name"
              value={etat.valeur('nom')}
              errors={etat.erreursChamps.nom}
              class="min-w-0 flex-[1_1_12.5rem]"
            />
            <Field
              name="email"
              label="E-mail"
              type="email"
              required
              autocomplete="email"
              value={etat.valeur('email')}
              errors={etat.erreursChamps.email}
              class="min-w-0 flex-[1_1_12.5rem]"
            />
          </div>
          <div class="flex flex-wrap gap-5">
            <Field
              name="telephone"
              label="Téléphone"
              type="tel"
              autocomplete="tel"
              value={etat.valeur('telephone')}
              errors={etat.erreursChamps.telephone}
              class="min-w-0 flex-[1_1_12.5rem]"
            />
            <div class="group flex min-w-0 flex-[1_1_12.5rem] flex-col gap-2">
              <label
                for="champ-projet"
                class="text-sm font-semibold transition-colors group-focus-within:text-bleu"
              >
                Votre projet <span class="font-normal text-discret">(facultatif)</span>
              </label>
              <select
                id="champ-projet"
                name="projet"
                class="block w-full rounded-xl border border-champ bg-white px-4 py-3.5 text-[0.9375rem] text-encre transition-colors focus:border-bleu"
              >
                <option value="">Choisissez un type de projet</option>
                {Object.entries(typesProjet).map(([valeur, libelle]) => (
                  <option value={valeur} selected={projetChoisi === valeur}>
                    {libelle}
                  </option>
                ))}
              </select>
            </div>
          </div>
          <Field
            name="message"
            label="Votre message"
            type="textarea"
            required
            hint="Quelques lignes suffisent : objectif, utilisateurs, fonctionnalités importantes et délai souhaité."
            value={etat.valeur('message')}
            errors={etat.erreursChamps.message}
          />
          <Consent
            errors={etat.erreursChamps.consentement}
            checked={etat.valeur('consentement') !== undefined}
          />
          <Honeypot />
          <button
            type="submit"
            class="w-full cursor-pointer rounded-full bg-bleu px-7 py-4 text-base font-semibold text-white transition-colors hover:bg-encre"
          >
            Envoyer ma demande
          </button>
          <p class="text-center text-[0.8125rem] text-discret">
            Gratuit et sans engagement. Vos informations servent uniquement à traiter votre demande.
            Pas de relance commerciale insistante.
          </p>
        </form>
      )}
    </CarteFormulaire>
  </section>

  <Section class="pb-20 sm:pb-32">
    <div class="flex flex-wrap gap-6">
      <Encadre
        ton="cadre"
        surtitre="Coordonnées"
        title="Autres moyens de nous joindre"
        espace="petit"
        class="flex-[1_1_23.75rem]"
      >
        <dl class="mt-2 border-t border-ligne">
          {coordonnees.map(({ label, valeur, href }) => (
            <div class="flex flex-wrap gap-x-6 gap-y-1 border-b border-ligne py-4 text-[0.9375rem]">
              <dt class="w-25 text-discret">{label}</dt>
              <dd class="min-w-0">
                {href ? (
                  <a
                    href={href}
                    class="text-bleu underline underline-offset-2 hover:text-encre hover:underline-offset-4"
                  >
                    {valeur}
                  </a>
                ) : (
                  <Texte texte={valeur} />
                )}
              </dd>
            </div>
          ))}
        </dl>
      </Encadre>
      <Encadre
        ton="sombre"
        surtitre="Audit gratuit"
        title="Vous avez déjà un site ?"
        espace="petit"
        class="flex flex-[1_1_23.75rem] flex-col"
      >
        <p class="max-w-[26.25rem] leading-[1.7] text-nuit-texte">
          Commencez par un audit gratuit : vitesse, sécurité, référencement technique et affichage
          mobile.
        </p>
        <div class="mt-auto pt-7">
          <ButtonLink href={cta.secondaire.href} variant="clair">
            {cta.secondaire.label}
          </ButtonLink>
        </div>
      </Encadre>
    </div>
  </Section>
</BaseLayout>
