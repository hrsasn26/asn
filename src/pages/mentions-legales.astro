---
// Projet de texte à faire valider par un juriste (docs/brief-agence.md, section 7).
// Droit marocain : identité et identifiants de l'entreprise (RC, ICE, IF, taxe professionnelle),
// informations du fournisseur (loi 31-08, article 29) et données personnelles (loi 09-08).
// Seules les parties confirmées sont affichées. Les parties qui attendent une information
// (identifiants, directeur de la publication, hébergeur, récépissé de la CNDP) sont dans la
// section 7 du brief, avec leurs placeholders.
import BarreLecture from '~/components/BarreLecture.astro';
import Prose from '~/components/Prose.astro';
import { site } from '~/data/site';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { estConfirme } from '~/lib/placeholders';
---

<BaseLayout
  title={`Mentions légales | ${site.nom}`}
  description={`Mentions légales du site ${site.nom} : éditeur, propriété intellectuelle et données personnelles.`}
  breadcrumbs={[{ label: 'Mentions légales', href: '/mentions-legales' }]}
>
  <BarreLecture />
  <section class="conteneur pt-12 pb-20 sm:pt-14 sm:pb-32">
    <h1 class="anim-montee text-titre">Mentions légales</h1>
    <div class="mt-12">
      <Prose>
        <h2>Éditeur du site</h2>
        <p>{`Le site ${site.domaine} est édité par ${site.nom}.`}</p>
        <ul>
          {estConfirme(site.telephone) && <li>Téléphone : {site.telephone}</li>}
          <li>
            E-mail : <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
        </ul>

        <h2>Propriété intellectuelle</h2>
        <p>
          Les textes, les illustrations et le code de ce site appartiennent à {site.nom}, sauf
          mention contraire. Vous ne pouvez pas les reproduire sans autorisation écrite.
        </p>

        <h2>Données personnelles</h2>
        <p>
          Les données collectées sur ce site sont traitées conformément à la loi 09-08 relative à la
          protection des personnes physiques à l'égard du traitement des données à caractère
          personnel.
        </p>
        <p>
          Pour savoir comment nous utilisons vos données, lisez notre{' '}
          <a href="/confidentialite">politique de confidentialité</a>.
        </p>
      </Prose>
    </div>
  </section>
</BaseLayout>
