---
// Projet de texte à faire valider par un juriste (docs/brief-agence.md, section 7).
// Droit marocain : identité et identifiants de l'entreprise (RC, ICE, IF, taxe professionnelle),
// informations du fournisseur (loi 31-08, article 29) et données personnelles (loi 09-08).
import BarreLecture from '~/components/BarreLecture.astro';
import Placeholder from '~/components/Placeholder.astro';
import Prose from '~/components/Prose.astro';
import Section from '~/components/Section.astro';
import { site } from '~/data/site';
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout
  title={`Mentions légales | ${site.nom}`}
  description={`Mentions légales du site ${site.nom} : éditeur, directeur de la publication, hébergeur et propriété intellectuelle.`}
  breadcrumbs={[{ label: 'Mentions légales', href: '/mentions-legales' }]}
>
  <BarreLecture />
  <Section decor>
    <h1 class="anim-montee text-3xl sm:text-4xl">Mentions légales</h1>
    <div class="mt-6 max-w-3xl">
      <Placeholder text="[Projet de texte : à faire valider par un juriste avant la mise en ligne]" />
    </div>
    <div class="mt-8">
      <Prose>
        <h2>Éditeur du site</h2>
        <p>
          {`Le site ${site.domaine} est édité par ${site.nom}, [forme juridique] au capital de [montant] DH.`}
        </p>
        <ul>
          <li>Siège social : [adresse]</li>
          <li>Registre du commerce : [ville], numéro [numéro]</li>
          <li>Identifiant commun de l'entreprise (ICE) : [numéro]</li>
          <li>Identifiant fiscal (IF) : [numéro]</li>
          <li>Taxe professionnelle : [numéro]</li>
          <li>Téléphone : {site.telephone}</li>
          <li>E-mail : {site.email}</li>
        </ul>

        <h2>Directeur de la publication</h2>
        <p>[Prénom Nom], [fonction].</p>

        <h2>Hébergement</h2>
        <p>[Nom de l'hébergeur], [adresse], [téléphone].</p>

        <h2>Propriété intellectuelle</h2>
        <p>
          Les textes, les illustrations et le code de ce site appartiennent à {site.nom}, sauf
          mention contraire. Vous ne pouvez pas les reproduire sans autorisation écrite.
        </p>

        <h2>Données personnelles</h2>
        <p>
          Les données collectées sur ce site sont traitées conformément à la loi 09-08 relative à la
          protection des personnes physiques à l'égard du traitement des données à caractère
          personnel. Déclaration auprès de la CNDP : [numéro de récépissé].
        </p>
        <p>
          Pour savoir comment nous utilisons vos données, lisez notre{' '}
          <a href="/confidentialite">politique de confidentialité</a>.
        </p>
      </Prose>
    </div>
  </Section>
</BaseLayout>
