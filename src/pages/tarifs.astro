---
// Page à rédiger (voir CLAUDE.md). Prix : src/data/tarifs.ts (placeholders du brief).
import ButtonLink from '~/components/ButtonLink.astro';
import ForfaitsTable from '~/components/ForfaitsTable.astro';
import Placeholder from '~/components/Placeholder.astro';
import Section from '~/components/Section.astro';
import { cta, site } from '~/data/site';
import { engagementMaintenance, tarifs } from '~/data/tarifs';
import BaseLayout from '~/layouts/BaseLayout.astro';

const forfaitsProjet = [
  { nom: 'Site vitrine', prix: `À partir de ${tarifs.siteVitrine}`, href: '/services/sites-web' },
  { nom: 'Boutique en ligne', prix: `À partir de ${tarifs.boutique}`, href: '/services/sites-web' },
  { nom: 'Refonte de site', prix: 'Sur devis', href: '/services/sites-web' },
  {
    nom: 'Première version de votre application (MVP)',
    prix: `À partir de ${tarifs.mvp}`,
    href: '/services/applications-sur-mesure',
  },
  {
    nom: 'Automatisation simple',
    prix: `À partir de ${tarifs.automatisation}`,
    href: '/services/automatisation-integrations',
  },
];
---

<BaseLayout
  title={`Tarifs | ${site.nom}`}
  description="[Meta description à rédiger]"
  breadcrumbs={[{ label: 'Tarifs', href: '/tarifs' }]}
>
  <Section>
    <h1 class="text-3xl sm:text-4xl">Tarifs</h1>
    <div class="mt-6 max-w-3xl">
      <Placeholder text="[À rédiger : introduction de la page Tarifs]" />
    </div>
  </Section>

  <Section title="Vos projets" tone="gris">
    <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {forfaitsProjet.map((forfait) => (
        <li class="rounded-lg border border-slate-200 bg-white p-6">
          <h3 class="text-lg">
            <a href={forfait.href} class="text-slate-900 hover:text-brand-700">
              {forfait.nom}
            </a>
          </h3>
          <p class="mt-2 font-semibold text-slate-900">{forfait.prix}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section title="Hébergement et maintenance">
    <ForfaitsTable />
    <p class="mt-4 text-slate-700">{engagementMaintenance}</p>
    <div class="mt-8">
      <ButtonLink href={cta.principal.href}>{cta.principal.label}</ButtonLink>
    </div>
  </Section>
</BaseLayout>
