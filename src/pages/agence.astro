---
// Textes : docs/brief-agence.md, section 6.10 (proposition à valider).
// Aucune information sur l'équipe n'est inventée : les membres restent des placeholders.
import Clock from '@lucide/astro/icons/clock';
import Eye from '@lucide/astro/icons/eye';
import KeyRound from '@lucide/astro/icons/key-round';
import Scale from '@lucide/astro/icons/scale';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import UserRound from '@lucide/astro/icons/user-round';
import CtaFinal from '~/components/CtaFinal.astro';
import FeatureGrid from '~/components/FeatureGrid.astro';
import Hero from '~/components/Hero.astro';
import IllustrationAgence from '~/components/illustrations/IllustrationAgence.astro';
import Placeholder from '~/components/Placeholder.astro';
import Section from '~/components/Section.astro';
import { cta, site } from '~/data/site';
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout
  title={`L'agence : une équipe d'ingénieurs à votre service | ${site.nom}`}
  description="Une équipe d'ingénieurs qui conçoit, teste, héberge et maintient des sites et des applications pour les TPE, PME et particuliers."
  breadcrumbs={[{ label: "L'agence", href: '/agence' }]}
>
  <Hero
    title="Une équipe d'ingénieurs, à la taille de votre projet"
    motCle="ingénieurs"
    subtitle={`Nous construisons des sites et des applications solides, et nous les suivons dans la durée. Nous sommes basés à ${site.zone}.`}
  >
    <IllustrationAgence slot="illustration" />
  </Hero>

  <Section title={`Pourquoi ${site.nom} existe`}>
    <div class="max-w-3xl space-y-4 text-lg text-slate-700">
      <p>
        Beaucoup de TPE et de PME ont vécu la même situation : un site livré sans tests, un
        prestataire qui ne répond plus, un site piraté faute de mises à jour. Nous avons créé{' '}
        {site.nom} pour proposer autre chose : des projets construits avec les méthodes des
        ingénieurs, et un suivi dans la durée.
      </p>
      <Placeholder text="[À rédiger : l'histoire de l'agence, en quelques phrases]" />
    </div>
  </Section>

  <Section title="Ce que nous savons faire, en clair" tone="gris">
    <ul class="grid max-w-3xl gap-3 text-slate-700">
      <li>
        <strong class="text-slate-900">Concevoir des outils solides</strong>, qui évoluent avec
        votre activité.
      </li>
      <li>
        <strong class="text-slate-900">Prendre en charge tout votre projet</strong>, de l'écran au
        serveur : vous avez un seul interlocuteur.
      </li>
      <li>
        <strong class="text-slate-900">Garder votre site en ligne</strong>, rapide et sauvegardé.
      </li>
      <li>
        <strong class="text-slate-900">Tout tester</strong> avant chaque mise en ligne.
      </li>
    </ul>
  </Section>

  <Section title="Nos valeurs">
    <FeatureGrid
      columns={3}
      items={[
        {
          title: 'Fiabilité',
          text: 'Nous livrons ce que nous avons testé.',
          icone: ShieldCheck,
        },
        {
          title: 'Transparence',
          text: 'Un prix fixe, et des explications sans jargon.',
          icone: Eye,
        },
        {
          title: 'Honnêteté',
          text: "Nous vous disons quand un projet n'est pas raisonnable. Nous ne promettons jamais de résultat que nous ne maîtrisons pas.",
          icone: Scale,
        },
        {
          title: 'Engagement dans la durée',
          text: 'Nous restons là après la mise en ligne.',
          icone: Clock,
        },
        {
          title: 'Liberté',
          text: 'Vous restez propriétaire de votre code, de votre nom de domaine et de vos données.',
          icone: KeyRound,
        },
      ]}
    />
  </Section>

  <Section title="L'équipe" tone="gris">
    <ul class="grid gap-6 md:grid-cols-3">
      {[1, 2, 3].map(() => (
        <li class="apparition rounded-lg border border-slate-200 bg-white p-6">
          <span class="inline-flex size-16 items-center justify-center rounded-full bg-slate-200 text-slate-500">
            <UserRound size={32} />
          </span>
          <p class="mt-4 font-semibold text-slate-900">[Prénom Nom]</p>
          <p class="text-sm text-slate-600">[Rôle]</p>
          <p class="mt-2 text-slate-700">[Une phrase de présentation]</p>
        </li>
      ))}
    </ul>
    <div class="mt-6 max-w-3xl">
      <Placeholder text="[Photos : à fournir]" />
    </div>
  </Section>

  <Section title="Nos partenaires">
    <p class="max-w-3xl text-lg text-slate-700">
      Pour le design, le logo et la rédaction, nous travaillons avec des indépendants de confiance :
      [graphiste partenaire], [rédacteur partenaire]. Le développement, lui, n'est jamais
      sous-traité.
    </p>
  </Section>

  <CtaFinal
    title="Parlons de votre projet"
    text="Un échange de 30 minutes, gratuit et sans engagement, pour comprendre votre besoin et vous dire honnêtement ce que nous pouvons faire pour vous."
    button={cta.principal}
  />
</BaseLayout>
