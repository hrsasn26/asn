---
// Textes : docs/brief-agence.md, section 6.10 (proposition à valider). Surtitres : section 6.20.
// Aucune information sur l'équipe n'est inventée : la section « L'équipe » est masquée
// jusqu'à réception des vrais noms, rôles et photos.
import CtaFinal from '~/components/CtaFinal.astro';
import Encadre from '~/components/Encadre.astro';
import FeatureGrid from '~/components/FeatureGrid.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import { cta, site } from '~/data/site';
import BaseLayout from '~/layouts/BaseLayout.astro';

const valeurs = [
  { title: 'Fiabilité', text: 'Nous livrons ce que nous avons vérifié.' },
  {
    title: 'Transparence',
    text: 'Un périmètre, un prix fixe et des choix expliqués clairement, sans jargon.',
  },
  {
    title: 'Honnêteté',
    text: "Nous vous disons quand un projet n'est pas raisonnable. Nous ne promettons jamais de résultat que nous ne maîtrisons pas.",
  },
  {
    title: 'Continuité',
    text: "Nous pouvons rester responsables de l'hébergement, de la maintenance et des évolutions.",
  },
  {
    title: 'Indépendance',
    text: 'Votre code, vos comptes, votre nom de domaine et vos données restent à votre nom.',
  },
];
---

<BaseLayout
  title={`L'agence : une équipe technique à votre service | ${site.nom}`}
  description="Une équipe qui conçoit, teste, héberge et maintient des sites et des applications, avec un interlocuteur direct."
  breadcrumbs={[{ label: "L'agence", href: '/agence' }]}
>
  <Hero
    title="Une équipe accessible, du premier échange au suivi"
    motCle="du premier échange au suivi"
    subtitle="Nous concevons des sites et des applications solides, avec un interlocuteur direct et une responsabilité claire sur la qualité technique."
  />

  <Section surtitre="Notre histoire" title={`Pourquoi ${site.nom} existe`} disposition="colonnes">
    <div class="apparition">
      <p class="text-lg leading-[1.7] sm:text-xl">
        Beaucoup d'entreprises ont vécu la même situation : un site livré sans tests, un prestataire
        qui ne répond plus, un site piraté faute de mises à jour.
      </p>
      <p class="mt-5 leading-[1.75] text-doux sm:text-[1.0625rem]">
        {`Nous avons créé ${site.nom} pour proposer autre chose : des projets construits avec méthode, testés, et un suivi dans la durée.`}
      </p>
    </div>
  </Section>

  <Section
    surtitre="Savoir-faire"
    title="Ce que nous savons faire, en clair"
    disposition="colonnes"
  >
    <FeatureGrid
      titresEnLigne
      items={[
        {
          title: 'Concevoir des outils solides',
          text: ', qui évoluent avec votre activité.',
        },
        {
          title: 'Prendre en charge tout votre projet',
          text: ", de l'écran au serveur : vous avez un seul interlocuteur.",
        },
        { title: 'Garder votre site en ligne', text: ', rapide et sauvegardé.' },
        { title: 'Tout tester', text: ' avant chaque mise en ligne.' },
      ]}
    />
  </Section>

  <Section surtitre="Valeurs" title="Nos valeurs" disposition="centre">
    <ul class="flex flex-wrap gap-4">
      {valeurs.map(({ title, text }, index) => {
        // La dernière valeur (Indépendance) est sur fond sombre, comme dans les maquettes.
        const sombre = index === valeurs.length - 1;
        return (
          <li
            class:list={[
              'apparition min-w-0 flex-[1_1_9.375rem] rounded-[1.25rem] p-6',
              sombre ? 'bg-encre text-white' : 'bg-surface',
            ]}
          >
            <p
              aria-hidden="true"
              class:list={[
                'text-[0.8125rem] font-semibold',
                sombre ? 'text-nuit-discret' : 'text-discret',
              ]}
            >
              {String(index + 1).padStart(2, '0')}
            </p>
            <h3 class="mt-7 text-xl">{title}</h3>
            <p
              class:list={[
                'mt-2 text-[0.9375rem] leading-[1.6]',
                sombre ? 'text-nuit-texte' : 'text-doux',
              ]}
            >
              {text}
            </p>
          </li>
        );
      })}
    </ul>
  </Section>

  <Section>
    <Encadre ton="cadre" surtitre="Réseau" title="Nos partenaires" disposition="colonnes">
      <p class="leading-[1.75] text-doux sm:text-[1.0625rem]">
        Pour le design, le logo et la rédaction, nous travaillons avec des indépendants de
        confiance.{' '}
        <strong class="font-semibold text-encre">
          Le développement, lui, n'est jamais sous-traité.
        </strong>
      </p>
    </Encadre>
  </Section>

  <CtaFinal
    title="Parlons de votre projet"
    motCle="projet"
    text="Un échange de 30 minutes, gratuit et sans engagement, pour comprendre votre besoin et vous dire honnêtement ce que nous pouvons faire pour vous."
    button={cta.principal}
  />
</BaseLayout>
