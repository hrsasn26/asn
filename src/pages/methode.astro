---
// Page à rédiger (voir CLAUDE.md). Étapes reprises du brief, section 6.1.
// Le brief demande une étape de tests bien visible sur cette page (section 5).
import CtaFinal from '~/components/CtaFinal.astro';
import Placeholder from '~/components/Placeholder.astro';
import Section from '~/components/Section.astro';
import Steps from '~/components/Steps.astro';
import { cta, site } from '~/data/site';
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout
  title={`Méthode | ${site.nom}`}
  description="[Meta description à rédiger]"
  breadcrumbs={[{ label: 'Méthode', href: '/methode' }]}
>
  <Section>
    <h1 class="text-3xl sm:text-4xl">Comment se déroule votre projet</h1>
    <div class="mt-10">
      <Steps
        items={[
          {
            title: 'On échange.',
            text: 'Un appel de 30 minutes, gratuit, pour comprendre votre besoin.',
          },
          {
            title: 'On vous envoie un devis clair.',
            text: 'Un prix fixe, des délais et la liste précise de ce qui est inclus.',
          },
          {
            title: 'On développe.',
            text: "Vous suivez l'avancement et validez chaque étape.",
          },
          {
            title: 'On teste.',
            text: 'Tout est vérifié avant la mise en ligne, sur tous les écrans.',
          },
          {
            title: 'On met en ligne et on reste là.',
            text: "On vous forme à l'utilisation, puis on assure la maintenance si vous le souhaitez.",
          },
        ]}
      />
    </div>
    <div class="mt-10 max-w-3xl">
      <Placeholder text="[À rédiger : détail de chaque étape, avec une étape de tests bien visible]" />
    </div>
  </Section>

  <CtaFinal
    title="Parlons de votre projet"
    text="Un échange de 30 minutes, gratuit et sans engagement, pour comprendre votre besoin et vous dire honnêtement ce que nous pouvons faire pour vous."
    button={cta.principal}
  />
</BaseLayout>
