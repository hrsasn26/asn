---
// Textes : docs/brief-agence.md, section 6.8 (proposition à valider). Surtitres : section 6.20.
// Le brief demande une étape de tests bien visible sur cette page (section 5) : elle détaille
// les vérifications, et l'encadré « Pourquoi les tests comptent autant » la suit.
import CtaFinal from '~/components/CtaFinal.astro';
import Encadre from '~/components/Encadre.astro';
import Faq from '~/components/Faq.astro';
import FaqItem from '~/components/FaqItem.astro';
import FeatureGrid from '~/components/FeatureGrid.astro';
import Hero from '~/components/Hero.astro';
import ListePoints from '~/components/ListePoints.astro';
import Section from '~/components/Section.astro';
import { cta, site } from '~/data/site';
import BaseLayout from '~/layouts/BaseLayout.astro';

interface Etape {
  title: string;
  text: string;
  liste?: string[];
  complement?: string;
  recu: string;
}

const etapes: Etape[] = [
  {
    title: 'Un premier échange, gratuit.',
    text: "Un appel de 30 minutes pour comprendre votre activité, votre besoin, vos contraintes et ce qui mérite vraiment d'être développé. Nous vous disons honnêtement si nous sommes la bonne équipe pour votre projet.",
    recu: 'un premier avis sur votre projet.',
  },
  {
    title: 'Un devis clair, à prix fixe.',
    text: 'Nous détaillons ce qui est inclus, le prix et les délais. Vous savez exactement ce que vous payez avant de vous engager.',
    recu: 'un devis écrit, avec la liste précise de ce qui est livré.',
  },
  {
    title: 'Les maquettes.',
    text: 'Vous voyez les écrans de votre site ou de votre application avant le début du développement. Vous demandez les modifications nécessaires, puis vous validez.',
    recu: 'les maquettes à valider.',
  },
  {
    title: 'Le développement, par étapes.',
    text: "Nous construisons votre projet par petites étapes. Vous suivez l'avancement et vous validez chaque étape : vous n'attendez pas la livraison finale pour voir le résultat.",
    recu: "l'accès à une version de test, mise à jour régulièrement.",
  },
  {
    title: 'Les tests.',
    text: 'Avant chaque mise en ligne, nous vérifions :',
    liste: [
      'chaque page, sur ordinateur, tablette et mobile, dans les principaux navigateurs ;',
      'chaque formulaire, chaque lien et chaque paiement ;',
      "la vitesse d'affichage de chaque page ;",
      "l'accessibilité, pour que tous vos visiteurs puissent utiliser votre site ;",
      'la sécurité : connexion HTTPS, protections contre le spam et les attaques courantes.',
    ],
    complement:
      'Pour les applications, des tests automatiques vérifient chaque nouvelle version : une amélioration ne casse pas ce qui fonctionnait déjà.',
    recu: 'un site ou une application vérifiés, prêts à être mis en ligne.',
  },
  {
    title: 'La mise en ligne et la formation.',
    text: "Nous mettons votre projet en ligne, nous vous transmettons tous les accès, puis nous vous montrons comment l'utiliser et le modifier vous-même.",
    recu: "l'accès complet à votre site, à votre code et à vos données.",
  },
  {
    title: 'Le suivi.',
    text: 'Si vous le souhaitez, nous hébergeons et maintenons votre projet avec un forfait mensuel : sauvegardes, mises à jour de sécurité, surveillance et petites modifications.',
    recu: 'selon votre forfait, un rapport mensuel clair.',
  },
];
---

<BaseLayout
  title={`Notre méthode : un projet clair, testé et suivi | ${site.nom}`}
  description="Échange gratuit, devis à prix fixe, maquettes, développement par étapes, tests complets et suivi après la mise en ligne : découvrez comment se déroule votre projet."
  breadcrumbs={[{ label: 'Méthode', href: '/methode' }]}
>
  <Hero
    title="Un projet clair, avec des validations à chaque étape"
    motCle="avec des validations à chaque étape"
    subtitle="Vous savez ce qui est prévu, ce que vous devez valider et ce que vous recevez. Les tests sont intégrés au projet, pas ajoutés à la fin."
  />

  <Section
    surtitre={`${etapes.length} étapes`}
    title="Les étapes de votre projet"
    disposition="colonnes"
    titreCollant
  >
    <ol>
      {etapes.map((etape, index) => {
        const derniere = index === etapes.length - 1;
        return (
          <li class="apparition grid grid-cols-[2.75rem_minmax(0,1fr)] gap-x-5 sm:gap-x-7">
            {/* Numéro et trait vertical jusqu'à l'étape suivante. */}
            <div aria-hidden="true" class="flex flex-col items-center">
              <span class="apparition-zoom grid size-11 shrink-0 place-items-center rounded-full bg-white text-[0.9375rem] font-semibold ring-1 ring-encre ring-inset">
                {index + 1}
              </span>
              {!derniere && <span class="mt-2 w-px flex-1 bg-trait" />}
            </div>
            <div class:list={['pt-2', !derniere && 'pb-12']}>
              <h3 class="text-[1.375rem] tracking-[-0.015em]">{etape.title}</h3>
              <p class="mt-3 max-w-[38.75rem] leading-[1.7] text-doux">{etape.text}</p>
              {etape.liste && <ListePoints items={etape.liste} class="mt-3.5" />}
              {etape.complement && (
                <p class="mt-3.5 max-w-[38.75rem] leading-[1.7] text-doux">{etape.complement}</p>
              )}
              <p class="mt-4.5 flex max-w-[38.75rem] flex-wrap items-baseline gap-x-3.5 gap-y-1 rounded-xl bg-surface px-4.5 py-3.5 text-[0.9375rem] leading-normal">
                <span class="text-[0.6875rem] font-semibold tracking-[0.18em] whitespace-nowrap text-discret uppercase">
                  Vous recevez
                </span>
                <span>{etape.recu}</span>
              </p>
            </div>
          </li>
        );
      })}
    </ol>
  </Section>

  <Section>
    <Encadre
      ton="sombre"
      surtitre="Qualité"
      title="Pourquoi les tests comptent autant"
      disposition="colonnes"
    >
      <p class="text-lg leading-[1.75] text-nuit-texte">
        Un bug découvert par un client coûte plus cher qu'un bug trouvé avant la mise en ligne : une
        vente perdue, une demande de contact jamais reçue, une image dégradée. C'est pourquoi les
        tests font partie de chaque projet et de chaque mise à jour.
      </p>
    </Encadre>
  </Section>

  <Section
    surtitre="Votre rôle"
    title="Ce dont nous avons besoin de votre part"
    disposition="colonnes"
  >
    <FeatureGrid
      min={220}
      titresEnLigne
      items={[
        {
          title: 'Vos textes et vos photos.',
          text: ' Si vous préférez déléguer, nous vous mettons en relation avec un rédacteur ou un photographe partenaire.',
        },
        {
          title: 'Vos accès :',
          text: ' nom de domaine, hébergement actuel, outils à connecter.',
        },
        { title: 'Un interlocuteur disponible', text: ' pour valider chaque étape.' },
      ]}
    />
  </Section>

  <Faq>
    <FaqItem question="Combien de temps dure un projet ?" ouvert>
      <p>
        Cela dépend du projet. Nous fixons le planning ensemble après le premier échange, et il
        figure dans le devis.
      </p>
    </FaqItem>
    <FaqItem question="Puis-je demander des changements en cours de projet ?">
      <p>
        Oui. Nous estimons l'effet sur le prix et sur le délai, puis vous décidez. Rien n'est ajouté
        à la facture sans votre accord.
      </p>
    </FaqItem>
    <FaqItem question="Que se passe-t-il si un problème apparaît après la mise en ligne ?">
      <p>
        Nous le corrigeons s'il est lié à notre travail, dans les conditions prévues au devis. Avec
        un forfait de maintenance, nous surveillons votre site et nous intervenons rapidement.
      </p>
    </FaqItem>
  </Faq>

  <CtaFinal
    title="Parlons de votre projet"
    motCle="projet"
    text="Un échange de 30 minutes, gratuit et sans engagement, pour comprendre votre besoin et vous dire honnêtement ce que nous pouvons faire pour vous."
    button={cta.principal}
  />
</BaseLayout>
