---
// Textes : docs/brief-agence.md, section 6.2. Surtitres des sections : section 6.20.
import ButtonLink from '~/components/ButtonLink.astro';
import CtaFinal from '~/components/CtaFinal.astro';
import Encadre from '~/components/Encadre.astro';
import Faq from '~/components/Faq.astro';
import FaqItem from '~/components/FaqItem.astro';
import FeatureGrid from '~/components/FeatureGrid.astro';
import Hero from '~/components/Hero.astro';
import LienFleche from '~/components/LienFleche.astro';
import OfferCard from '~/components/OfferCard.astro';
import ProblemList from '~/components/ProblemList.astro';
import Section from '~/components/Section.astro';
import { surtitreService } from '~/data/navigation';
import { site } from '~/data/site';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { serviceJsonLd } from '~/lib/seo';

const title = 'Création de site vitrine et e-commerce';
const description =
  'Site vitrine, boutique en ligne ou refonte : des sites rapides, sécurisés et prêts pour le référencement.';
const ctaSite = { label: 'Parler de mon futur site', href: '/contact' };
---

<BaseLayout
  title={`${title} | ${site.nom}`}
  description={description}
  breadcrumbs={[
    { label: 'Services', href: '/services' },
    { label: 'Sites web', href: '/services/sites-web' },
  ]}
  jsonLd={serviceJsonLd({ name: title, description })}
>
  <Hero
    maquette="sites-web"
    surtitre={surtitreService('/services/sites-web')}
    title="Un site rapide, crédible et pensé pour générer des contacts"
    motCle="pensé pour générer des contacts"
    subtitle="Site vitrine, boutique en ligne ou refonte : nous créons un site adapté au mobile, simple à modifier vous-même et techniquement prêt pour le référencement."
  >
    <ButtonLink href={ctaSite.href}>{ctaSite.label}</ButtonLink>
  </Hero>

  <ProblemList
    title="Votre site vous fait perdre des clients ?"
    items={[
      "Il met plusieurs secondes à s'afficher, et les visiteurs partent avant de le voir.",
      "Il s'affiche mal sur téléphone.",
      'Personne ne le trouve sur Google.',
      'Chaque modification passe par un prestataire qui ne répond plus.',
    ]}
  />

  <Section
    surtitre="Nos formules"
    title="Trois façons de lancer ou de relancer votre présence en ligne"
    disposition="centre"
  >
    <div class="flex flex-wrap gap-6">
      <OfferCard
        title="Site vitrine"
        text="Pour présenter clairement votre activité et vos réalisations, et être contacté facilement."
        idealPour="artisans, indépendants."
        items={[
          'Formulaire de contact',
          'Prise de rendez-vous en ligne (en option)',
          'Liens vers vos réseaux sociaux et votre fiche Google',
        ]}
      />
      <OfferCard
        title="Boutique en ligne"
        text="Pour vendre en ligne, avec un parcours d'achat simple, des paiements sécurisés et une gestion adaptée à votre activité."
        idealPour="commerçants, créateurs."
        items={[
          'Paiement sécurisé (carte bancaire via le CMI, paiement à la livraison…)',
          'Gestion des stocks et des commandes',
          'Frais de livraison et factures automatiques',
          'Shopify, WooCommerce ou sur mesure, selon votre volume de ventes',
        ]}
      />
      <OfferCard
        title="Refonte de site"
        text="Pour moderniser votre site sans perdre ce qui fonctionne : contenus, redirections, vitesse et affichage mobile sont traités dès le départ."
        idealPour="tout site vieillissant ou qui ne vous apporte plus de contacts."
        items={[
          'Reprise de vos contenus',
          'Redirections des anciennes pages pour conserver votre référencement',
          'Nouveau design, plus rapide et adapté au mobile',
        ]}
      />
    </div>
    <p class="apparition mt-8 text-center text-[0.9375rem] text-doux">
      Chaque projet fait l'objet d'un devis gratuit et détaillé, à prix fixe.
    </p>
  </Section>

  <Section surtitre="Sans supplément" title="Inclus dans tous nos sites" disposition="colonnes">
    <FeatureGrid
      min={240}
      items={[
        { title: 'Adapté à tous les écrans', text: 'Ordinateur, tablette et téléphone.' },
        { title: 'Rapide', text: 'Nous mesurons la vitesse de chaque page avant la livraison.' },
        {
          title: 'Référencement technique',
          text: 'Structure des pages, balises, plan du site et données structurées pour que Google comprenne votre activité.',
        },
        {
          title: 'Sécurisé',
          text: 'Connexion HTTPS, protections contre le spam et les attaques courantes.',
        },
        {
          title: 'Conforme à la loi 09-08',
          text: 'Données personnelles protégées, bandeau cookies et pages légales mises en place.',
        },
        {
          title: 'Accessible',
          text: 'Lisible par tous, y compris par les personnes en situation de handicap.',
        },
        {
          title: 'Modifiable par vous',
          text: "Un espace d'administration simple pour changer vos textes et vos images.",
        },
        { title: 'Formation incluse', text: 'Nous vous montrons comment gérer votre site.' },
      ]}
    />
  </Section>

  {/* Ajout à valider (section 6.2 du brief, « Les options »). */}
  <Section surtitre="À la carte" title="Les options">
    <div class="flex flex-wrap gap-6">
      <Encadre class="flex-[1.3_1_26.25rem]" espace="petit">
        {/* Langues proposées : décoratif, le texte les cite. */}
        <div aria-hidden="true" class="flex gap-2 text-xs font-semibold">
          <span class="rounded-full bg-white px-2.5 py-1">FR</span>
          <span lang="ar" class="rounded-full bg-white px-2.5 py-1">
            ع
          </span>
          <span class="rounded-full bg-white px-2.5 py-1">EN</span>
        </div>
        <h3 class="mt-6 text-[1.375rem]">Un site en plusieurs langues</h3>
        <p class="mt-3 leading-[1.7] text-doux">
          Français, arabe, anglais : chaque visiteur lit votre site dans sa langue. La version arabe
          s'affiche de droite à gauche, avec une mise en page adaptée. Chaque langue a ses propres
          pages, que Google peut référencer. Vous nous fournissez les textes traduits. Si besoin,
          nous vous mettons en relation avec un traducteur.
        </p>
      </Encadre>
      <Encadre class="flex flex-[1_1_21.25rem] flex-col" espace="petit">
        <span aria-hidden="true" class="block size-9 rounded-full bg-whatsapp"></span>
        <h3 class="mt-6 text-[1.375rem]">WhatsApp sur votre site</h3>
        <p class="mt-3 leading-[1.7] text-doux">
          Un bouton pour vous écrire sur WhatsApp en un clic. Nous pouvons aussi relier WhatsApp à
          vos outils et envoyer des messages automatiques.
        </p>
        <p class="mt-auto pt-5">
          <LienFleche
            href="/services/automatisation-integrations#whatsapp"
            label="Voir l'offre Automatisation"
          />
        </p>
      </Encadre>
    </div>
  </Section>

  <Section>
    <div class="flex flex-wrap gap-6">
      <Encadre
        ton="sombre"
        surtitre="Qualité"
        title="Testé avant la mise en ligne. Vraiment."
        motCle="Vraiment."
        espace="moyen"
        class="flex-[1_1_26.25rem]"
      >
        <p class="leading-[1.75] text-nuit-texte">
          Avant de livrer votre site, nous vérifions chaque page sur les principaux navigateurs et
          tailles d'écran. Nous testons chaque formulaire, chaque lien et chaque paiement. Vous ne
          découvrez pas les problèmes par un client mécontent.
        </p>
      </Encadre>
      <Encadre
        ton="cadre"
        surtitre="Design"
        title="Un site à votre image"
        espace="moyen"
        class="flex-[1_1_26.25rem]"
      >
        <div class="space-y-3.5 leading-[1.75] text-doux">
          <p>
            Vous validez les maquettes avant le début du développement : pas de mauvaise surprise à
            la livraison.
          </p>
          <p>
            Vous n'avez pas encore de logo ? Nous pouvons vous mettre en relation avec un graphiste
            partenaire.
          </p>
        </div>
      </Encadre>
    </div>
  </Section>

  <Faq>
    <FaqItem question="Pourrai-je modifier mon site moi-même ?" ouvert>
      <p>
        Oui. Vous disposez d'un espace d'administration pour changer vos textes, vos images et
        ajouter des pages ou des articles. Nous vous formons à son utilisation à la livraison.
      </p>
    </FaqItem>
    <FaqItem question="Vous occupez-vous des textes et des photos ?">
      <p>
        Pas directement. Vous nous fournissez vos textes et vos photos, et nous vous aidons à les
        organiser. Si vous préférez déléguer, nous pouvons vous mettre en relation avec un rédacteur
        ou un photographe partenaire.
      </p>
    </FaqItem>
    <FaqItem question="Mon site sera-t-il bien référencé sur Google ?">
      <p>
        Il sera techniquement prêt. Nous nous occupons de toute la partie technique du référencement
        : vitesse, structure, balises, compatibilité mobile. Votre position dans Google dépend aussi
        de vos contenus et de la concurrence dans votre secteur : personne ne peut honnêtement vous
        garantir la première place.
      </p>
    </FaqItem>
    <FaqItem question="WordPress ou développement sur mesure ?">
      <p>
        Cela dépend de votre besoin. WordPress convient très bien à la plupart des sites vitrines.
        Le sur-mesure devient intéressant quand vous avez des fonctionnalités spécifiques ou de gros
        volumes.
      </p>
    </FaqItem>
    <FaqItem question="Combien de temps faut-il pour créer mon site ?">
      <p>
        Cela dépend du site et de la rapidité à laquelle nous recevons vos contenus. Nous fixons le
        planning ensemble, et il figure dans le devis.
      </p>
    </FaqItem>
    <FaqItem question="Que se passe-t-il après la mise en ligne ?">
      <p>
        Votre site vous appartient. Vous pouvez le gérer seul, ou nous confier son hébergement et sa
        maintenance avec l'un de nos{' '}
        <a href="/services/hebergement-maintenance#forfaits">forfaits mensuels</a>.
      </p>
    </FaqItem>
  </Faq>

  <CtaFinal
    title="Parlons de votre futur site"
    motCle="futur site"
    text="Décrivez-nous votre projet en quelques lignes. Nous revenons vers vous avec les prochaines étapes."
    button={ctaSite}
  />
</BaseLayout>
