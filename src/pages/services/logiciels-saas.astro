---
// Surtitres des sections : docs/brief-agence.md, section 6.20.
// Textes : docs/brief-agence.md, section 6.15 (proposition à valider).
import ButtonLink from '~/components/ButtonLink.astro';
import CtaFinal from '~/components/CtaFinal.astro';
import Faq from '~/components/Faq.astro';
import FaqItem from '~/components/FaqItem.astro';
import FeatureGrid from '~/components/FeatureGrid.astro';
import Hero from '~/components/Hero.astro';
import ProblemList from '~/components/ProblemList.astro';
import Section from '~/components/Section.astro';
import Steps from '~/components/Steps.astro';
import Texte from '~/components/Texte.astro';
import { delais, site } from '~/data/site';
import { surtitreService } from '~/data/navigation';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { serviceJsonLd } from '~/lib/seo';

const title = 'Développement de logiciel SaaS par abonnement';
const description =
  'Vous voulez vendre un logiciel en ligne par abonnement ? Nous développons votre SaaS : comptes clients, abonnements, paiement en ligne, sécurité et suivi.';
const ctaProjet = { label: 'Présenter mon idée', href: '/contact' };
---

<BaseLayout
  title={`${title} | ${site.nom}`}
  description={description}
  breadcrumbs={[
    { label: 'Services', href: '/services' },
    { label: 'Logiciels SaaS', href: '/services/logiciels-saas' },
  ]}
  jsonLd={serviceJsonLd({ name: title, description })}
>
  <Hero
    maquette="logiciels-saas"
    surtitre={surtitreService('/services/logiciels-saas')}
    title="Votre logiciel en ligne, vendu par abonnement"
    motCle="vendu par abonnement"
    subtitle="Vous avez une idée de logiciel pour les entreprises ou pour les particuliers ? Nous développons votre plateforme, de la première version au lancement, puis nous la faisons évoluer avec vous."
  >
    <ButtonLink href={ctaProjet.href}>{ctaProjet.label}</ButtonLink>
  </Hero>

  <Section surtitre="Définition" title="Un SaaS, en clair" disposition="colonnes">
    <p class="apparition text-lg leading-[1.75] text-doux">
      Un SaaS (« logiciel en tant que service ») est un logiciel que vos clients utilisent en ligne,
      depuis leur navigateur ou leur téléphone. Ils n'installent rien et ils paient un abonnement.
      Vous gérez une seule version du logiciel pour tous vos clients.
    </p>
  </Section>

  <ProblemList
    title="Les pièges d'un projet SaaS"
    items={[
      'Vous voulez tout développer avant de trouver votre premier client.',
      "Les données d'un client s'affichent chez un autre, et la confiance est perdue.",
      'Le logiciel ralentit quand le nombre de clients augmente.',
      'Chaque nouvelle version casse une fonction que vos clients utilisaient.',
    ]}
  />

  <Section surtitre="Nos solutions" title="Tout ce dont votre SaaS a besoin" disposition="centre">
    <FeatureGrid
      variante="cartes"
      min={400}
      items={[
        {
          title: 'Comptes et équipes',
          text: 'Inscription, connexion sécurisée, gestion des utilisateurs et de leurs droits. Les données de chaque client restent séparées de celles des autres.',
        },
        {
          title: 'Abonnements et paiement',
          text: "Formules, période d'essai, paiement en ligne et factures automatiques. Nous choisissons avec vous la solution de paiement adaptée à vos clients, au Maroc ou à l'international.",
        },
        {
          title: "Espace d'administration",
          text: "Vous suivez vos clients, vos abonnements et l'utilisation de votre logiciel, sans passer par nous.",
        },
        {
          title: "Connexion avec d'autres logiciels",
          text: 'Vos clients relient votre SaaS à leurs propres outils : comptabilité, CRM, e-mailing. Votre logiciel devient plus utile, et plus difficile à remplacer.',
        },
      ]}
    />
  </Section>

  <Section surtitre="Notre différence" title="Construit pour grandir" disposition="colonnes">
    <FeatureGrid
      items={[
        {
          title: 'Des bases solides',
          text: 'Nous concevons votre logiciel pour accueillir de nouveaux clients et de nouvelles fonctionnalités sans tout reconstruire.',
        },
        {
          title: 'Testé à chaque version',
          text: 'Des tests automatiques vérifient chaque nouvelle version avant sa mise en ligne. Vos clients ne découvrent pas les bugs à votre place.',
        },
        {
          title: 'Sécurité et sauvegardes',
          text: 'Connexions chiffrées, accès contrôlés, sauvegardes quotidiennes et surveillance 24 h/24.',
        },
        {
          title: 'Des mises à jour sans surprise',
          text: 'Nous préparons chaque mise en ligne pour éviter les coupures de service. En cas de problème, nous revenons à la version précédente en quelques minutes.',
        },
      ]}
    />
  </Section>

  <Section surtitre="Méthode" title="Du cadrage aux premiers clients" disposition="centre">
    <Steps
      items={[
        {
          title: 'Atelier de cadrage.',
          text: "Nous listons les fonctions essentielles pour vos premiers clients et nous définissons les formules d'abonnement.",
        },
        {
          title: 'Maquettes.',
          text: 'Vous voyez les écrans et vous pouvez les montrer à vos futurs clients avant le développement.',
        },
        {
          title: 'Première version.',
          text: "L'essentiel pour vendre et recueillir les avis de vos premiers clients.",
        },
        {
          title: 'Tests et lancement.',
          text: 'Tests automatiques, vérifications manuelles, puis mise en ligne.',
        },
        {
          title: 'Évolutions et suivi.',
          text: 'Nous hébergeons, surveillons et faisons évoluer votre logiciel selon les retours de vos clients.',
        },
      ]}
    />
  </Section>

  <Faq>
    <FaqItem question="Combien coûte le développement d'un SaaS ?" ouvert>
      <p>
        Cela dépend des fonctionnalités. Après l'atelier de cadrage, nous vous remettons un devis
        gratuit, à prix fixe, pour la première version.
      </p>
    </FaqItem>
    <FaqItem question="Combien de temps faut-il ?">
      <p>
        <Texte
          texte={`Une première version demande en général ${delais.mvp}. Nous fixons le planning ensemble après le cadrage.`}
        />
      </p>
    </FaqItem>
    <FaqItem question="Qui est propriétaire du logiciel ?">
      <p>
        Vous. Le code, les données et les comptes (hébergement, paiement, nom de domaine) sont à
        votre nom.
      </p>
    </FaqItem>
    <FaqItem question="Mon idée sera-t-elle protégée ?">
      <p>
        Oui. Nous pouvons signer un accord de confidentialité avant d'entrer dans les détails de
        votre projet.
      </p>
    </FaqItem>
    <FaqItem question="Pouvez-vous héberger et maintenir le logiciel après le lancement ?">
      <p>
        Oui. Nous proposons l'hébergement, la surveillance et les évolutions dans un forfait mensuel
        adapté à votre nombre de clients.
      </p>
    </FaqItem>
    <FaqItem question="Mes clients sont à l'étranger. Est-ce un problème ?">
      <p>
        <Texte texte="Non, mais les règles changent selon les pays : protection des données, facturation, paiement. Nous en tenons compte dès le cadrage. [À valider avec un juriste selon les pays visés]" />
      </p>
    </FaqItem>
  </Faq>

  <CtaFinal
    title="Présentez-nous votre idée de SaaS"
    motCle="votre idée de SaaS"
    text="Un échange de 30 minutes, gratuit et confidentiel, pour parler de votre idée, de vos futurs clients et de ce qui est réaliste pour une première version."
    button={ctaProjet}
  />
</BaseLayout>
