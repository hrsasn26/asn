---
// Surtitres des sections : docs/brief-agence.md, section 6.20.
// Textes : docs/brief-agence.md, section 6.5.
import ButtonLink from '~/components/ButtonLink.astro';
import CtaFinal from '~/components/CtaFinal.astro';
import Encadre from '~/components/Encadre.astro';
import Faq from '~/components/Faq.astro';
import FaqItem from '~/components/FaqItem.astro';
import FeatureGrid from '~/components/FeatureGrid.astro';
import ForfaitsTable from '~/components/ForfaitsTable.astro';
import Hero from '~/components/Hero.astro';
import ProblemList from '~/components/ProblemList.astro';
import Section from '~/components/Section.astro';
import Texte from '~/components/Texte.astro';
import { cta, delais, site } from '~/data/site';
import { engagementMaintenance } from '~/data/forfaits';
import { surtitreService } from '~/data/navigation';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { serviceJsonLd } from '~/lib/seo';

const title = 'Hébergement et maintenance de site web';
const description =
  'Hébergement sécurisé, sauvegardes, mises à jour et support : nous gardons votre site et vos applications en ligne, rapides et protégés. Forfaits mensuels.';
const ctaForfait = { label: 'Choisir mon forfait', href: '/contact' };
---

<BaseLayout
  title={`${title} | ${site.nom}`}
  description={description}
  breadcrumbs={[
    { label: 'Services', href: '/services' },
    { label: 'Hébergement et maintenance', href: '/services/hebergement-maintenance' },
  ]}
  jsonLd={serviceJsonLd({ name: title, description })}
>
  <Hero
    maquette="hebergement-maintenance"
    surtitre={surtitreService('/services/hebergement-maintenance')}
    title="Votre site toujours en ligne. Vous n'avez plus à y penser."
    motCle="Vous n'avez plus à y penser."
    subtitle="Hébergement, sauvegardes, mises à jour de sécurité, surveillance et petites modifications : nous nous occupons de la technique, vous gardez l'esprit libre."
  >
    <ButtonLink href="#forfaits">Voir les forfaits</ButtonLink>
    <ButtonLink href="/contact" variant="secondaire">
      Demander un devis
    </ButtonLink>
  </Hero>

  <ProblemList
    title="Un site sans maintenance est un site en danger"
    items={[
      "Les extensions et logiciels non mis à jour sont l'une des principales portes d'entrée des pirates.",
      'Un site en panne un week-end, ce sont des clients perdus sans que vous le sachiez.',
      'Sans sauvegarde, une erreur ou une attaque peut tout effacer.',
    ]}
  />

  <Section surtitre="Inclus" title="Tout ce dont votre site a besoin" disposition="colonnes">
    <FeatureGrid
      min={240}
      items={[
        {
          title: 'Hébergement géré',
          text: `Serveurs en ${site.hebergement}, connexion HTTPS, nom de domaine et e-mails professionnels.`,
        },
        {
          title: 'Sauvegardes vérifiées',
          text: `Des sauvegardes automatiques, conservées ${delais.retentionSauvegardes} jours. Nous testons régulièrement leur restauration : une sauvegarde jamais testée n'est pas une vraie sauvegarde.`,
        },
        {
          title: 'Surveillance 24 h/24',
          text: 'Si votre site ne répond plus, nous sommes alertés immédiatement et nous intervenons.',
        },
        {
          title: 'Mises à jour de sécurité testées',
          text: "Nous appliquons les mises à jour après avoir vérifié qu'elles ne cassent rien.",
        },
        {
          title: 'Petites modifications',
          text: 'Un texte à changer, une image à remplacer, une page à ajouter : envoyez-nous un message, nous nous en occupons.',
        },
        {
          title: 'Rapport mensuel',
          text: 'Chaque mois, un résumé clair : disponibilité du site, sauvegardes réalisées, mises à jour effectuées.',
        },
      ]}
    />
  </Section>

  <Section surtitre="Forfaits" title="Choisissez votre forfait" id="forfaits">
    <ForfaitsTable />
    <p class="apparition mt-6 text-[0.9375rem] leading-[1.65] text-doux">
      <Texte
        texte={`Le prix de chaque forfait dépend de votre site : il figure dans votre devis gratuit. ${engagementMaintenance}`}
      />
    </p>
    <div class="apparition mt-8">
      <ButtonLink href={ctaForfait.href}>{ctaForfait.label}</ButtonLink>
    </div>
  </Section>

  <Section>
    <Encadre
      ton="sombre"
      surtitre="Reprise de site"
      title="Votre prestataire a disparu ? Votre site est cassé ?"
      disposition="colonnes"
    >
      <p class="text-lg leading-[1.75] text-nuit-texte">
        Nous reprenons les sites et applications développés par d'autres. Nous commençons par un
        audit : état du code, sécurité, sauvegardes, accès. Ensuite, nous vous proposons un plan
        clair : corriger, stabiliser, ou reconstruire si c'est plus raisonnable.
      </p>
      <div class="mt-8">
        <ButtonLink href={cta.secondaire.href} variant="clair">
          {cta.secondaire.label}
        </ButtonLink>
      </div>
    </Encadre>
  </Section>

  <Faq>
    <FaqItem question="Pouvez-vous héberger un site que vous n'avez pas créé ?" ouvert>
      <p>
        Oui. Nous faisons d'abord un audit pour vérifier son état, puis nous le migrons sur nos
        serveurs sans interruption de service.
      </p>
    </FaqItem>
    <FaqItem question="Que se passe-t-il si mon site est piraté ?">
      <p>
        Nous le restaurons à partir de la dernière sauvegarde saine, nous corrigeons la faille et
        nous renforçons la sécurité.
      </p>
    </FaqItem>
    <FaqItem question="À qui appartient mon nom de domaine ?">
      <p>À vous. Il est enregistré à votre nom.</p>
    </FaqItem>
    <FaqItem question="Puis-je partir si je change d'avis ?">
      <p>Oui. Nous vous remettons votre site complet, votre code et vos données.</p>
    </FaqItem>
  </Faq>

  <CtaFinal
    title="Confiez-nous la technique"
    motCle="la technique"
    text="Votre site est entre de bonnes mains, et vous pouvez vous concentrer sur votre activité."
    button={ctaForfait}
  />
</BaseLayout>
