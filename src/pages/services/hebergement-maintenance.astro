---
// Textes : docs/brief-agence.md, section 6.5.
import Activity from '@lucide/astro/icons/activity';
import FileText from '@lucide/astro/icons/file-text';
import HardDrive from '@lucide/astro/icons/hard-drive';
import PencilLine from '@lucide/astro/icons/pencil-line';
import Server from '@lucide/astro/icons/server';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import ButtonLink from '~/components/ButtonLink.astro';
import CtaFinal from '~/components/CtaFinal.astro';
import Faq from '~/components/Faq.astro';
import FaqItem from '~/components/FaqItem.astro';
import FeatureGrid from '~/components/FeatureGrid.astro';
import ForfaitsTable from '~/components/ForfaitsTable.astro';
import Hero from '~/components/Hero.astro';
import ProblemList from '~/components/ProblemList.astro';
import Section from '~/components/Section.astro';
import { cta, site } from '~/data/site';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { serviceJsonLd } from '~/lib/seo';

const title = 'Hébergement et maintenance de site web';
const description =
  'Hébergement sécurisé, sauvegardes, mises à jour et support : nous gardons votre site et vos applications en ligne, rapides et protégés. Forfaits mensuels.';
const ctaForfait = { label: 'Choisir mon forfait', href: '/contact' };
---

<BaseLayout
  title={`${title} | ${site.nom}`}
  description={description}
  breadcrumbs={[
    { label: 'Services', href: '/services' },
    { label: 'Hébergement et maintenance', href: '/services/hebergement-maintenance' },
  ]}
  jsonLd={serviceJsonLd({ name: title, description })}
>
  <Hero
    maquette="hebergement-maintenance"
    title="Votre site reste disponible, sauvegardé et à jour"
    motCle="disponible"
    subtitle="Nous gérons l'hébergement, les sauvegardes, la surveillance et les mises à jour, pour que vous n'ayez pas à vous occuper de la technique au quotidien."
  >
    <ButtonLink href="#forfaits">Voir les forfaits</ButtonLink>
    <ButtonLink href={cta.devis.href} variant="secondaire">
      {cta.devis.label}
    </ButtonLink>
  </Hero>

  <ProblemList
    title="Pourquoi un site a besoin de maintenance"
    items={[
      "Les extensions et logiciels non mis à jour sont l'une des principales portes d'entrée des pirates.",
      'Un site en panne un week-end, ce sont des clients perdus sans que vous le sachiez.',
      'Sans sauvegarde, une erreur ou une attaque peut tout effacer.',
    ]}
  />

  <Section title="Tout ce dont votre site a besoin">
    <FeatureGrid
      columns={3}
      items={[
        {
          title: 'Hébergement géré',
          icone: Server,
          text: 'Un hébergement sécurisé, configuré et suivi, avec connexion HTTPS, nom de domaine et e-mails professionnels.',
        },
        {
          title: 'Sauvegardes vérifiées',
          icone: HardDrive,
          text: "Des sauvegardes automatiques, dont nous testons régulièrement la restauration : une sauvegarde jamais testée n'est pas une vraie sauvegarde.",
        },
        {
          title: 'Surveillance 24 h/24',
          icone: Activity,
          text: 'Si votre site ne répond plus, nous sommes alertés immédiatement. Nous intervenons selon votre forfait.',
        },
        {
          title: 'Mises à jour de sécurité testées',
          icone: ShieldCheck,
          text: "Nous appliquons les mises à jour après avoir vérifié qu'elles ne cassent rien.",
        },
        {
          title: 'Petites modifications',
          icone: PencilLine,
          text: 'Un texte à changer, une image à remplacer, une page à ajouter : envoyez-nous un message. Le volume inclus dépend de votre forfait.',
        },
        {
          title: 'Rapport mensuel',
          icone: FileText,
          text: 'Chaque mois, un résumé clair : disponibilité du site, sauvegardes réalisées, mises à jour effectuées.',
        },
      ]}
    />
  </Section>

  <Section title="Choisissez votre forfait" tone="gris" id="forfaits">
    <ForfaitsTable />
    <p class="apparition mt-4 text-slate-700">
      Le prix de chaque forfait dépend de votre site : il figure dans votre devis gratuit, avec le
      volume de modifications inclus.
    </p>
    <div class="apparition mt-6">
      <ButtonLink href={ctaForfait.href}>{ctaForfait.label}</ButtonLink>
    </div>
  </Section>

  <Section title="Votre prestataire a disparu ? Votre site est cassé ?">
    <p class="apparition max-w-3xl text-lg text-slate-700">
      Nous reprenons les sites et applications développés par d'autres. Nous commençons par un audit
      : état du code, sécurité, sauvegardes, accès. Ensuite, nous vous proposons un plan clair :
      corriger, stabiliser, ou reconstruire si c'est plus raisonnable.
    </p>
    <div class="apparition mt-6">
      <ButtonLink href={cta.secondaire.href} variant="secondaire">
        {cta.secondaire.label}
      </ButtonLink>
    </div>
  </Section>

  <Faq>
    <FaqItem question="Pouvez-vous héberger un site que vous n'avez pas créé ?">
      <p>
        Oui. Nous faisons d'abord un audit pour vérifier son état, puis nous le migrons sur nos
        serveurs sans interruption de service.
      </p>
    </FaqItem>
    <FaqItem question="Que se passe-t-il si mon site est piraté ?">
      <p>
        Nous le restaurons à partir de la dernière sauvegarde saine, nous corrigeons la faille et
        nous renforçons la sécurité.
      </p>
    </FaqItem>
    <FaqItem question="À qui appartient mon nom de domaine ?">
      <p>À vous. Il est enregistré à votre nom.</p>
    </FaqItem>
    <FaqItem question="Puis-je partir si je change d'avis ?">
      <p>Oui. Nous vous remettons votre site complet, votre code et vos données.</p>
    </FaqItem>
  </Faq>

  <CtaFinal
    title="Confiez-nous la technique"
    text="Votre site est entre de bonnes mains, et vous pouvez vous concentrer sur votre activité."
    button={ctaForfait}
  />
</BaseLayout>
