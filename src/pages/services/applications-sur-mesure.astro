---
// Surtitres des sections : docs/brief-agence.md, section 6.20.
// Textes : docs/brief-agence.md, section 6.3.
import ButtonLink from '~/components/ButtonLink.astro';
import CtaFinal from '~/components/CtaFinal.astro';
import Encadre from '~/components/Encadre.astro';
import Faq from '~/components/Faq.astro';
import FaqItem from '~/components/FaqItem.astro';
import FeatureGrid from '~/components/FeatureGrid.astro';
import Hero from '~/components/Hero.astro';
import LienFleche from '~/components/LienFleche.astro';
import ProblemList from '~/components/ProblemList.astro';
import Section from '~/components/Section.astro';
import Steps from '~/components/Steps.astro';
import { site } from '~/data/site';
import { surtitreService } from '~/data/navigation';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { serviceJsonLd } from '~/lib/seo';

const title = 'Applications web et mobiles sur mesure';
const description =
  'Outil métier, espace client, application mobile ou première version de votre projet : nous développons des applications sur mesure, testées et faites pour évoluer.';
const ctaProjet = { label: 'Parler de mon projet', href: '/contact' };
---

<BaseLayout
  title={`${title} | ${site.nom}`}
  description={description}
  breadcrumbs={[
    { label: 'Services', href: '/services' },
    { label: 'Applications sur mesure', href: '/services/applications-sur-mesure' },
  ]}
  jsonLd={serviceJsonLd({ name: title, description })}
>
  <Hero
    maquette="applications-sur-mesure"
    surtitre={surtitreService('/services/applications-sur-mesure')}
    title="Un logiciel qui s'adapte à votre métier"
    motCle="votre métier"
    subtitle="Réservation, devis, planning, espace client ou outil interne : nous développons les fonctions dont vous avez réellement besoin, puis nous les faisons évoluer avec vous."
  >
    <ButtonLink href={ctaProjet.href}>{ctaProjet.label}</ButtonLink>
  </Hero>

  <ProblemList
    title="Vos outils actuels vous ralentissent ?"
    items={[
      'Tout est géré dans des tableurs, avec des erreurs de copie.',
      "Vous payez plusieurs logiciels qui ne font qu'à moitié ce que vous voulez.",
      "Vos clients vous appellent pour des informations qu'ils pourraient trouver en ligne.",
      "Vous avez une idée d'application, mais vous ne savez pas par où commencer.",
    ]}
  />

  <Section
    surtitre="Nos solutions"
    title="Ce que nous pouvons construire pour vous"
    disposition="centre"
  >
    <FeatureGrid
      variante="cartes"
      min={300}
      items={[
        {
          title: 'Outils métier',
          text: "Prise de rendez-vous, devis et factures, gestion de stock, planning d'équipe : réunissez dans un seul outil ce qui est aujourd'hui dispersé entre tableurs, e-mails et logiciels mal adaptés.",
        },
        {
          title: 'Première version de votre projet (MVP)',
          text: "Vous avez une idée d'application ? Lancez une première version utile, testez-la avec de vrais utilisateurs, puis investissez dans ce qui fonctionne.",
        },
        {
          title: 'Espaces clients et portails',
          text: 'Vos clients consultent leurs demandes, leurs documents et leur suivi en ligne, sans vous appeler.',
        },
      ]}
    />
    <ul class="mt-10 flex flex-col items-center gap-2 text-center text-[0.9375rem] text-doux">
      <li class="apparition">
        <LienFleche
          href="/services/applications-mobiles"
          label="Voir l'offre Applications mobiles"
        />
      </li>
      <li class="apparition">
        Vous voulez vendre votre logiciel par abonnement ?{' '}
        <LienFleche href="/services/logiciels-saas" label="Voir l'offre Logiciels SaaS" />
      </li>
    </ul>
  </Section>

  <Section
    surtitre="Notre différence"
    title="Une application solide, pas un prototype fragile"
    disposition="colonnes"
  >
    <FeatureGrid
      items={[
        {
          title: 'Pensée pour évoluer',
          text: "Nous concevons votre application pour que l'on puisse ajouter des fonctionnalités dans deux ans sans tout reconstruire.",
        },
        {
          title: 'Testée automatiquement',
          text: 'Chaque nouvelle version est vérifiée par des tests automatiques. Une amélioration ne casse pas ce qui fonctionnait déjà.',
        },
        {
          title: 'Vos données protégées',
          text: 'Sauvegardes quotidiennes et accès sécurisés.',
        },
        {
          title: 'Un code qui vous appartient',
          text: 'Le code est documenté et vous appartient. Vous restez libre de changer de prestataire si vous le souhaitez.',
        },
      ]}
    />
  </Section>

  <Section surtitre="Processus" title="Comment nous travaillons" disposition="centre">
    <Steps
      items={[
        {
          title: 'Atelier de cadrage.',
          text: "Nous listons ensemble les fonctionnalités et nous gardons l'essentiel pour la première version.",
        },
        {
          title: 'Maquettes.',
          text: "Vous voyez les écrans de votre application avant qu'une seule ligne de code soit écrite.",
        },
        {
          title: 'Développement par étapes.',
          text: "Une nouvelle version à tester régulièrement. Vous suivez l'avancement concrètement.",
        },
        {
          title: 'Tests.',
          text: 'Tests automatiques et vérifications manuelles avant chaque mise en ligne.',
        },
        {
          title: 'Mise en ligne et suivi.',
          text: 'Nous formons vos équipes, puis nous assurons la maintenance et les évolutions.',
        },
      ]}
    />
  </Section>

  <Section>
    <Encadre
      ton="sombre"
      surtitre="Porteurs de projet"
      title="Vous avez une idée d'application ? Commencez petit."
      motCle="Commencez petit."
      disposition="colonnes"
    >
      <p class="text-lg leading-[1.75] text-nuit-texte">
        Plutôt que de tout développer d'un coup, nous construisons d'abord une version simple, avec
        les fonctionnalités essentielles. Vous la testez auprès de vrais utilisateurs, puis vous
        décidez de la suite en connaissance de cause. Vous dépensez moins, et vous apprenez plus
        vite.
      </p>
      <div class="mt-8">
        <ButtonLink href="/contact" variant="clair">
          Parler de mon idée
        </ButtonLink>
      </div>
    </Encadre>
  </Section>

  <Faq>
    <FaqItem question="Combien coûte une application sur mesure ?" ouvert>
      <p>
        Cela dépend des fonctionnalités. Après l'atelier de cadrage, nous vous remettons un devis
        gratuit, à prix fixe.
      </p>
    </FaqItem>
    <FaqItem question="Combien de temps faut-il ?">
      <p>
        Cela dépend des fonctionnalités. Nous fixons le planning ensemble après le cadrage, et il
        figure dans le devis.
      </p>
    </FaqItem>
    <FaqItem question="Mon idée sera-t-elle protégée ?">
      <p>
        Oui. Nous pouvons signer un accord de confidentialité avant d'entrer dans les détails de
        votre projet.
      </p>
    </FaqItem>
    <FaqItem question="Serai-je propriétaire du code ?">
      <p>Oui. La cession des droits sur le code est prévue dans le contrat.</p>
    </FaqItem>
    <FaqItem question="J'ai déjà une application développée par un autre prestataire. Pouvez-vous la reprendre ?">
      <p>
        Oui. Nous commençons par un audit du code pour faire le point, puis nous vous proposons un
        plan : corriger, faire évoluer ou reconstruire certaines parties.
      </p>
    </FaqItem>
  </Faq>

  <CtaFinal
    title="Parlons de votre projet"
    motCle="projet"
    text="Un échange de 30 minutes, gratuit et confidentiel, pour comprendre votre besoin et vous dire ce qui est réaliste, dans quel délai et pour quel budget."
    button={ctaProjet}
  />
</BaseLayout>
