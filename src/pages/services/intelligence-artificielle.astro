---
// Surtitres des sections : docs/brief-agence.md, section 6.20.
// Textes : docs/brief-agence.md, section 6.16 (proposition à valider, avec la section Formation).
import Placeholder from '~/components/Placeholder.astro';
import ButtonLink from '~/components/ButtonLink.astro';
import CtaFinal from '~/components/CtaFinal.astro';
import Encadre from '~/components/Encadre.astro';
import Faq from '~/components/Faq.astro';
import FaqItem from '~/components/FaqItem.astro';
import FeatureGrid from '~/components/FeatureGrid.astro';
import Hero from '~/components/Hero.astro';
import ListePoints from '~/components/ListePoints.astro';
import ProblemList from '~/components/ProblemList.astro';
import Section from '~/components/Section.astro';
import Steps from '~/components/Steps.astro';
import Texte from '~/components/Texte.astro';
import { offre, site } from '~/data/site';
import { surtitreService } from '~/data/navigation';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { serviceJsonLd } from '~/lib/seo';

const title = "Intégration de l'intelligence artificielle en entreprise";
const description =
  "Assistant pour vos clients, recherche dans vos documents, lecture automatique des factures : nous intégrons l'IA là où elle vous fait gagner du temps.";
const ctaProjet = { label: 'Parler de mon projet IA', href: '/contact' };
---

<BaseLayout
  title={`${title} | ${site.nom}`}
  description={description}
  breadcrumbs={[
    { label: 'Services', href: '/services' },
    { label: 'Intelligence artificielle', href: '/services/intelligence-artificielle' },
  ]}
  jsonLd={serviceJsonLd({ name: title, description })}
>
  <Hero
    maquette="intelligence-artificielle"
    surtitre={surtitreService('/services/intelligence-artificielle')}
    title="L'intelligence artificielle, là où elle vous fait vraiment gagner du temps"
    motCle="gagner du temps"
    subtitle="Assistants pour vos clients et pour vos équipes, traitement de documents, rédaction assistée : nous intégrons l'IA dans vos outils, avec des résultats vérifiés et vos données protégées."
  >
    <ButtonLink href={ctaProjet.href}>{ctaProjet.label}</ButtonLink>
  </Hero>

  <ProblemList
    title="L'IA vous intéresse, mais par où commencer ?"
    items={[
      "Vous entendez parler d'IA partout, sans savoir ce qu'elle peut faire pour votre activité.",
      'Vous répondez chaque jour aux mêmes questions, par téléphone, par e-mail ou sur WhatsApp.',
      'Vos équipes passent des heures à lire, recopier et classer des documents.',
      "Vos équipes utilisent déjà des outils d'IA, sans règles pour protéger vos données.",
    ]}
  />

  <Section surtitre="Nos solutions" title="Ce que l'IA peut faire pour vous" disposition="centre">
    <FeatureGrid
      variante="cartes"
      min={400}
      items={[
        {
          title: 'Un assistant pour vos clients',
          text: 'Sur votre site ou sur WhatsApp, il répond aux questions fréquentes à partir de vos informations : horaires, tarifs, suivi de commande. Quand il ne sait pas, il transmet la demande à votre équipe.',
        },
        {
          title: 'Un assistant pour vos équipes',
          text: "Vos collaborateurs posent leurs questions sur vos procédures, vos catalogues ou vos contrats. Ils reçoivent une réponse avec le document d'origine.",
        },
        {
          title: 'Le traitement de vos documents',
          text: "Factures, bons de commande, formulaires : l'IA lit les documents, extrait les informations et les range dans vos outils. Votre équipe vérifie seulement les cas douteux.",
        },
        {
          title: 'La rédaction assistée',
          text: "Réponses aux e-mails, fiches produits, comptes rendus de réunion : l'IA prépare un brouillon, vous le relisez et vous le validez.",
        },
      ]}
    />
  </Section>

  {/* Ajout à valider (section 6.16 du brief, « Formation »). */}
  <Section id="formation">
    <Encadre surtitre="Formation" title="Former vos équipes à l'IA" disposition="colonnes">
      <div class="space-y-4 leading-[1.75] text-doux sm:text-[1.0625rem]">
        <p>
          Vos équipes utilisent déjà des outils d'IA comme ChatGPT ? Nous organisons des ateliers
          pratiques, avec vos propres cas de travail. Vos équipes apprennent à :
        </p>
        <ListePoints
          items={[
            'rédiger des demandes claires pour obtenir de bonnes réponses ;',
            'vérifier les réponses et repérer les erreurs ;',
            "savoir quelles informations ne jamais confier à un outil d'IA ;",
            "utiliser l'IA pour les tâches de tous les jours : e-mails, résumés, tableaux.",
          ]}
        />
        <p>
          À la fin de l'atelier, vous recevez des règles d'utilisation simples, adaptées à votre
          entreprise.
        </p>
        <Placeholder text="[Durée et nombre de participants : à définir]" />
      </div>
      <div class="mt-8">
        <ButtonLink href="/contact">Organiser un atelier</ButtonLink>
      </div>
    </Encadre>
  </Section>

  <Section surtitre="Notre différence" title="Une IA testée et encadrée" disposition="colonnes">
    <FeatureGrid
      items={[
        {
          title: 'Testée avec vos vraies questions',
          text: 'Avant la mise en service, nous vérifions les réponses sur une liste de cas réels, préparée avec vous. Nous corrigeons les erreurs avant vos clients.',
        },
        {
          title: 'Honnête sur ses limites',
          text: "L'assistant cite ses sources et dit quand il ne sait pas. Pour les décisions importantes, une personne valide toujours le résultat.",
        },
        {
          title: 'Vos données protégées',
          text: `Nous choisissons des services d'IA qui n'utilisent pas vos données pour entraîner leurs modèles, et nous respectons la loi 09-08. ${offre.confidentialiteIA}`,
        },
        {
          title: 'Suivie dans la durée',
          text: "Nous surveillons la qualité des réponses et les coûts d'utilisation. Nous mettons l'assistant à jour quand vos informations changent.",
        },
      ]}
    />
  </Section>

  <Section surtitre="Méthode" title="Comment nous travaillons" disposition="centre">
    <Steps
      items={[
        {
          title: 'Diagnostic.',
          text: "Nous repérons avec vous les tâches où l'IA peut vous faire gagner du temps, et celles où elle n'est pas utile.",
        },
        {
          title: 'Essai sur vos données.',
          text: 'Nous construisons un premier prototype avec vos documents et vos vraies questions.',
        },
        {
          title: 'Tests.',
          text: 'Nous mesurons la qualité des réponses et nous corrigeons avant la mise en service.',
        },
        {
          title: 'Mise en service et formation.',
          text: "Nous intégrons l'IA dans vos outils et nous formons vos équipes.",
        },
        {
          title: 'Suivi.',
          text: "Nous surveillons les résultats et les coûts, et nous adaptons l'assistant.",
        },
      ]}
    />
  </Section>

  <Faq>
    <FaqItem question="L'IA peut-elle se tromper ?" ouvert>
      <p>
        Oui. C'est pourquoi nous testons les réponses avant la mise en service, nous limitons
        l'assistant à vos informations et nous prévoyons une vérification par une personne là où une
        erreur aurait des conséquences.
      </p>
    </FaqItem>
    <FaqItem question="L'assistant comprend-il l'arabe et la darija ?">
      <p>
        Les services d'IA actuels comprennent le français, l'arabe et l'anglais. Pour la darija, les
        résultats varient : nous faisons des essais avec vos propres exemples avant de vous proposer
        une solution.
      </p>
    </FaqItem>
    <FaqItem question="Mes données sont-elles en sécurité ?">
      <p>
        <Texte
          texte={`Nous choisissons des services d'IA qui n'utilisent pas vos données pour entraîner leurs modèles. Nous limitons les données envoyées au strict nécessaire. ${offre.confidentialiteIA}`}
        />
      </p>
    </FaqItem>
    <FaqItem question="Combien ça coûte ?">
      <p>
        Cela dépend de l'assistant et de vos données. Nous vous remettons un devis gratuit, à prix
        fixe. Le service d'IA est facturé en plus, selon l'utilisation : nous estimons ce coût avec
        vous avant de commencer.
      </p>
    </FaqItem>
    <FaqItem question="Dois-je changer mes outils ?">
      <p>
        Non. Nous intégrons l'IA dans les outils que vous utilisez déjà : site, messagerie, CRM,
        dossiers partagés.
      </p>
    </FaqItem>
  </Faq>

  <CtaFinal
    title="Où l'IA peut-elle vous faire gagner du temps ?"
    motCle="gagner du temps ?"
    text="Décrivez-nous les tâches qui vous prennent du temps. Nous vous disons gratuitement si l'IA peut vous aider, et comment."
    button={ctaProjet}
  />
</BaseLayout>
