---
import Accent from '~/components/Accent.astro';
import ButtonLink from '~/components/ButtonLink.astro';
import { site } from '~/data/site';
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title={`Page introuvable | ${site.nom}`} description="Cette page n'existe pas.">
  <section class="conteneur pt-20 pb-24 sm:pt-28 sm:pb-36">
    <p class="anim-montee surtitre text-discret">Erreur 404</p>
    <h1 class="anim-montee mt-5 text-titre">
      <Accent texte="Page introuvable" motCle="introuvable" />
    </h1>
    <p class="anim-montee mt-7 max-w-[40rem] text-lg leading-[1.65] text-texte delai-150 sm:text-[1.1875rem]">
      Cette page n'existe pas ou a été déplacée. Vérifiez l'adresse, ou revenez à l'accueil.
    </p>
    <div class="anim-montee mt-9 delai-300">
      <ButtonLink href="/">Revenir à l'accueil</ButtonLink>
    </div>
  </section>
</BaseLayout>
