---
import ButtonLink from '~/components/ButtonLink.astro';
import IllustrationIntrouvable from '~/components/illustrations/IllustrationIntrouvable.astro';
import Section from '~/components/Section.astro';
import Souligne from '~/components/Souligne.astro';
import { site } from '~/data/site';
import BaseLayout from '~/layouts/BaseLayout.astro';
---

<BaseLayout title={`Page introuvable | ${site.nom}`} description="Cette page n'existe pas.">
  <Section>
    <div class="grid items-center gap-10 md:grid-cols-2">
      <div>
        <h1 class="anim-montee text-3xl sm:text-4xl">
          Page <Souligne>introuvable</Souligne>
        </h1>
        <p class="anim-montee mt-4 text-lg text-slate-700 delai-150">
          Cette page n'existe pas ou a été déplacée. Vérifiez l'adresse, ou revenez à l'accueil.
        </p>
        <div class="anim-montee mt-8 delai-300">
          <ButtonLink href="/">Revenir à l'accueil</ButtonLink>
        </div>
      </div>
      <div class="mx-auto w-full max-w-sm md:max-w-none">
        <IllustrationIntrouvable />
      </div>
    </div>
  </Section>
</BaseLayout>
