---
// Textes : docs/brief-agence.md, section 6.6. Surtitres des sections : section 6.20.
import { actions } from 'astro:actions';
import ButtonLink from '~/components/ButtonLink.astro';
import Encadre from '~/components/Encadre.astro';
import EnteteSection from '~/components/EnteteSection.astro';
import FeatureGrid from '~/components/FeatureGrid.astro';
import CarteFormulaire from '~/components/forms/CarteFormulaire.astro';
import Consent from '~/components/forms/Consent.astro';
import ErrorSummary from '~/components/forms/ErrorSummary.astro';
import Field from '~/components/forms/Field.astro';
import Honeypot from '~/components/forms/Honeypot.astro';
import Success from '~/components/forms/Success.astro';
import Hero from '~/components/Hero.astro';
import LienFleche from '~/components/LienFleche.astro';
import ListePoints from '~/components/ListePoints.astro';
import Section from '~/components/Section.astro';
import { site } from '~/data/site';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { etatFormulaire } from '~/lib/formulaire';
import { preoccupations } from '~/lib/schemas';

export const prerender = false;

const etat = await etatFormulaire(Astro.getActionResult(actions.audit), Astro.request, [
  'adresseSite',
  'nom',
  'email',
  'telephone',
  'preoccupation',
  'consentement',
]);
const preoccupationChoisie = etat.valeur('preoccupation');
const titre = `Audit gratuit de votre site web | ${site.nom}`;
---

<BaseLayout
  title={etat.enErreur ? `Erreur : ${titre}` : titre}
  description="Vitesse, sécurité, référencement, affichage mobile : recevez gratuitement un audit technique de votre site, avec un rapport clair et les actions prioritaires."
  breadcrumbs={[{ label: 'Audit gratuit', href: '/audit-gratuit' }]}
>
  <Hero
    maquette="audit-gratuit"
    surtitre="Audit gratuit"
    title="Obtenez un diagnostic clair de votre site"
    motCle="un diagnostic clair de votre site"
    subtitle="Nous vérifions gratuitement les principaux points techniques qui peuvent freiner votre site : vitesse, sécurité de base, référencement technique et affichage mobile."
  >
    <ButtonLink href="#demande">Demander mon audit</ButtonLink>
  </Hero>

  <Section surtitre="Périmètre" title="Ce que nous vérifions" disposition="colonnes">
    <FeatureGrid
      items={[
        {
          title: 'Vitesse',
          text: "Combien de temps vos pages mettent à s'afficher, et ce qui les ralentit.",
        },
        {
          title: 'Sécurité de base',
          text: "Certificat HTTPS, mises à jour et failles visibles de l'extérieur.",
        },
        {
          title: 'Référencement technique',
          text: 'Ce qui empêche Google de bien comprendre votre site.',
        },
        {
          title: 'Affichage mobile',
          text: 'Comment vos visiteurs voient et utilisent votre site sur téléphone.',
        },
      ]}
    />
  </Section>

  <Section>
    <Encadre
      ton="cadre"
      surtitre="Limites"
      title="Ce que l'audit gratuit ne couvre pas"
      disposition="colonnes"
    >
      <p class="leading-[1.75] text-doux sm:text-[1.0625rem]">
        L'audit gratuit regarde votre site de l'extérieur, sans accès au code ni au serveur. Il ne
        remplace pas un audit de sécurité complet. Les corrections ne sont pas incluses : vous les
        faites avec votre prestataire, ou nous vous proposons un devis.
      </p>
      <p class="mt-6">
        <LienFleche href="/services/tests-securite" label="Voir l'offre Tests et sécurité" />
      </p>
    </Encadre>
  </Section>

  <Section id="demande" class="pb-20 sm:pb-32">
    <div class="flex flex-wrap items-start gap-x-20 gap-y-12">
      <div class="apparition min-w-0 flex-[1_1_20rem]">
        <EnteteSection surtitre="Livrables" title="Ce que vous recevez" />
        <ListePoints
          variante="lignes"
          class="mt-8 leading-[1.6] [&_li]:py-4.5"
          items={[
            'Un rapport écrit, sans jargon',
            'Les problèmes classés par priorité : ce qui est urgent, ce qui peut attendre',
            'Les actions recommandées pour chaque problème',
          ]}
        />
      </div>

      <CarteFormulaire class="max-w-full min-w-0 flex-[1.3_1_28.75rem]">
        <h2 class="text-2xl font-semibold tracking-[-0.02em]">Demander mon audit</h2>
        {etat.envoye ? (
          <div class="mt-6">
            <Success title="Votre demande d'audit est envoyée">
              <p>Nous revenons vers vous avec votre rapport.</p>
            </Success>
          </div>
        ) : (
          <form
            method="POST"
            action={actions.audit}
            novalidate
            class="relative mt-6 flex flex-col gap-5"
          >
            <ErrorSummary errors={etat.resume} message={etat.messageGeneral} />
            <Field
              name="adresseSite"
              label="Adresse de votre site"
              required
              autocomplete="url"
              inputmode="url"
              hint="Par exemple : monsite.ma"
              value={etat.valeur('adresseSite')}
              errors={etat.erreursChamps.adresseSite}
            />
            <div class="flex flex-wrap gap-5">
              <Field
                name="nom"
                label="Nom"
                required
                autocomplete="name"
                value={etat.valeur('nom')}
                errors={etat.erreursChamps.nom}
                class="min-w-0 flex-[1_1_12.5rem]"
              />
              <Field
                name="email"
                label="E-mail"
                type="email"
                required
                autocomplete="email"
                value={etat.valeur('email')}
                errors={etat.erreursChamps.email}
                class="min-w-0 flex-[1_1_12.5rem]"
              />
            </div>
            <Field
              name="telephone"
              label="Téléphone"
              type="tel"
              autocomplete="tel"
              value={etat.valeur('telephone')}
              errors={etat.erreursChamps.telephone}
            />
            <fieldset class="group">
              <legend class="text-sm font-semibold transition-colors group-focus-within:text-bleu">
                Votre principale préoccupation{' '}
                <span class="font-normal text-discret">(facultatif)</span>
              </legend>
              {/*
               * Boutons radio en forme de pastille : le bouton couvre toute la pastille
               * (appearance-none), le choix est visible par le fond bleu (has-checked).
               */}
              <div class="mt-2.5 flex flex-wrap gap-2">
                {Object.entries(preoccupations).map(([valeur, libelle]) => (
                  <label class="relative inline-flex cursor-pointer items-center rounded-full px-4 py-2.5 text-sm font-medium ring-1 ring-champ transition-colors ring-inset hover:ring-bleu has-checked:bg-bleu has-checked:text-white has-checked:ring-bleu">
                    <input
                      type="radio"
                      id={`champ-preoccupation-${valeur}`}
                      name="preoccupation"
                      value={valeur}
                      checked={preoccupationChoisie === valeur}
                      class="absolute inset-0 size-full cursor-pointer appearance-none rounded-full"
                    />
                    {libelle}
                  </label>
                ))}
              </div>
            </fieldset>
            <Consent
              errors={etat.erreursChamps.consentement}
              checked={etat.valeur('consentement') !== undefined}
            />
            <Honeypot />
            <button
              type="submit"
              class="w-full cursor-pointer rounded-full bg-bleu px-7 py-4 text-base font-semibold text-white transition-colors hover:bg-encre"
            >
              Recevoir mon audit gratuit
            </button>
            <p class="text-center text-[0.8125rem] text-discret">
              Gratuit, sans engagement et sans relances insistantes.
            </p>
          </form>
        )}
      </CarteFormulaire>
    </div>
  </Section>
</BaseLayout>
