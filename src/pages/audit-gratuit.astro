---
// Textes : docs/brief-agence.md, section 6.6.
import CircleCheck from '@lucide/astro/icons/circle-check';
import Gauge from '@lucide/astro/icons/gauge';
import ScanSearch from '@lucide/astro/icons/scan-search';
import Search from '@lucide/astro/icons/search';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Smartphone from '@lucide/astro/icons/smartphone';
import IllustrationAudit from '~/components/illustrations/IllustrationAudit.astro';
import { actions } from 'astro:actions';
import Consent from '~/components/forms/Consent.astro';
import ErrorSummary from '~/components/forms/ErrorSummary.astro';
import Field from '~/components/forms/Field.astro';
import Honeypot from '~/components/forms/Honeypot.astro';
import Success from '~/components/forms/Success.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import { couleurPalette } from '~/data/couleurs';
import { delais, site } from '~/data/site';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { etatFormulaire } from '~/lib/formulaire';
import { preoccupations } from '~/lib/schemas';

export const prerender = false;

const etat = await etatFormulaire(Astro.getActionResult(actions.audit), Astro.request, [
  'adresseSite',
  'nom',
  'email',
  'telephone',
  'preoccupation',
  'consentement',
]);
const preoccupationChoisie = etat.valeur('preoccupation');
const titre = `Audit gratuit de votre site web | ${site.nom}`;

// Les quatre points vérifiés, chacun avec son icône (apparition en cascade).
const verifications = [
  {
    Icone: Gauge,
    titre: 'Vitesse',
    texte: "combien de temps vos pages mettent à s'afficher, et pourquoi.",
    delai: 'delai-300',
  },
  {
    Icone: ShieldCheck,
    titre: 'Sécurité',
    texte: 'certificat HTTPS, mises à jour, failles connues.',
    delai: 'delai-400',
  },
  {
    Icone: Search,
    titre: 'Référencement technique',
    texte: 'ce qui empêche Google de bien comprendre votre site.',
    delai: 'delai-500',
  },
  {
    Icone: Smartphone,
    titre: 'Affichage mobile',
    texte: 'comment vos visiteurs voient votre site sur téléphone.',
    delai: 'delai-600',
  },
];
---

<BaseLayout
  title={etat.enErreur ? `Erreur : ${titre}` : titre}
  description="Vitesse, sécurité, référencement, affichage mobile : recevez gratuitement un audit technique de votre site, avec un rapport clair et les actions prioritaires."
  breadcrumbs={[{ label: 'Audit gratuit', href: '/audit-gratuit' }]}
>
  <Hero
    title="Votre site est-il lent, vulnérable ou invisible sur Google ?"
    motCle="invisible"
    subtitle="Recevez gratuitement un audit technique de votre site. Un rapport clair, sans jargon, avec les actions prioritaires à mener."
  >
    <IllustrationAudit slot="illustration" />
  </Hero>

  <Section>
    <div class="grid gap-12 lg:grid-cols-2">
      <div class="space-y-10">
        <div>
          <h2 class="text-2xl">Ce que nous vérifions</h2>
          <ul class="mt-4 space-y-4 text-slate-700">
            {verifications.map(({ Icone, titre, texte, delai }, index) => (
              <li class="apparition flex items-start gap-3">
                <span
                  class:list={[
                    'anim-zoom inline-flex size-9 shrink-0 items-center justify-center rounded-lg',
                    couleurPalette(index).douce,
                    delai,
                  ]}
                >
                  <Icone size={20} />
                </span>
                <p class="pt-1.5">
                  <strong class="text-slate-900">{titre}</strong>
                  {` : ${texte}`}
                </p>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="text-2xl">Ce que vous recevez</h2>
          <ul class="mt-4 space-y-2 text-slate-700">
            {[
              `Un rapport écrit sous ${delais.rapportAudit}`,
              'La liste des problèmes, classés par priorité',
              delais.appelAudit,
            ].map((element, index) => (
              <li class="apparition flex items-start gap-3">
                <CircleCheck
                  size={20}
                  aria-hidden="true"
                  class:list={[
                    'anim-zoom mt-0.5 shrink-0 text-emerald-600',
                    ['delai-700', 'delai-800', 'delai-900'][index],
                  ]}
                />
                <span>{element}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div>
        <h2 class="mb-6 text-2xl">Demander mon audit</h2>
        {etat.envoye ? (
          <Success title="Votre demande d'audit est envoyée">
            <p>Vous recevez votre rapport sous {delais.rapportAudit}.</p>
          </Success>
        ) : (
          <>
            <ErrorSummary errors={etat.resume} message={etat.messageGeneral} />
            <form method="POST" action={actions.audit} novalidate class="relative space-y-6">
              <Field
                name="adresseSite"
                label="Adresse de votre site"
                required
                autocomplete="url"
                inputmode="url"
                hint="Par exemple : monsite.ma"
                value={etat.valeur('adresseSite')}
                errors={etat.erreursChamps.adresseSite}
              />
              <Field
                name="nom"
                label="Nom"
                required
                autocomplete="name"
                value={etat.valeur('nom')}
                errors={etat.erreursChamps.nom}
              />
              <Field
                name="email"
                label="E-mail"
                type="email"
                required
                autocomplete="email"
                value={etat.valeur('email')}
                errors={etat.erreursChamps.email}
              />
              <Field
                name="telephone"
                label="Téléphone"
                type="tel"
                autocomplete="tel"
                value={etat.valeur('telephone')}
                errors={etat.erreursChamps.telephone}
              />
              <fieldset class="group">
                <legend class="font-medium text-slate-900 transition-colors group-focus-within:text-brand-700">
                  Votre principale préoccupation{' '}
                  <span class="font-normal text-slate-600">(facultatif)</span>
                </legend>
                <div class="mt-2 space-y-2">
                  {Object.entries(preoccupations).map(([valeur, libelle]) => (
                    <div class="flex items-center gap-3">
                      <input
                        type="radio"
                        id={`champ-preoccupation-${valeur}`}
                        name="preoccupation"
                        value={valeur}
                        checked={preoccupationChoisie === valeur}
                        class="size-5 accent-brand-700"
                      />
                      <label for={`champ-preoccupation-${valeur}`}>{libelle}</label>
                    </div>
                  ))}
                </div>
              </fieldset>
              <Consent
                errors={etat.erreursChamps.consentement}
                checked={etat.valeur('consentement') !== undefined}
              />
              <Honeypot />
              <div>
                <button
                  type="submit"
                  class="group inline-flex items-center gap-2 rounded-md bg-brand-700 px-5 py-3 font-semibold text-white transition hover:bg-brand-800 hover:shadow-md motion-safe:hover:-translate-y-0.5"
                >
                  Recevoir mon audit gratuit
                  <ScanSearch
                    size={18}
                    aria-hidden="true"
                    class="transition-transform motion-safe:group-hover:scale-110 motion-safe:group-hover:-rotate-12"
                  />
                </button>
                <p class="mt-3 text-sm text-slate-600">
                  Gratuit, sans engagement et sans relances insistantes.
                </p>
              </div>
            </form>
          </>
        )}
      </div>
    </div>
  </Section>
</BaseLayout>
